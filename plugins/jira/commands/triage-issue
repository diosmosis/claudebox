#!/usr/bin/env bash
# description: fetch a JIRA issue and have the box verify it and write a failing test
#
# Two halves, and the split between them is the point:
#
#   on the host   fetch the issue with the API token and write it into the
#                 project as markdown;
#   in the box    a headless session that is handed the issue text in its prompt,
#                 decides whether the bug is real, and writes a failing
#                 regression test on a branch.
#
# The token never crosses the line. The box is handed a markdown file, which is
# issue text and nothing else -- see lib/jira.sh.
set -euo pipefail
. "${CLAUDEBOX_PLUGIN_API}"
. "${CLAUDEBOX_PLUGIN_DIR}/lib/jira.sh"

usage() {
    cat >&2 <<'USAGE'
usage: claudebox jira:triage-issue <ISSUE-KEY> [options]

  <ISSUE-KEY>          e.g. AS-345, MWP-123
  --project <path>     the git project to work in (default: the current
                       directory). Must be inside the workspace -- it is the
                       only host tree the box can see.
  --dir <path>         where to write <KEY>.md, relative to the project.
                       Default: "claudebox jira:config"'s issue dir, or the
                       project root.
  --fetch-only         write the markdown and stop, without starting a session.

Fetches the issue on THIS machine and writes <KEY>.md into the project, then
runs a claude session in the box, in auto mode, asking it to verify the report
and write a failing regression test on a new branch. Claude's answer is printed
when it finishes.
USAGE
}

key="" project="" issue_dir="" issue_dir_given="" fetch_only=""
while [ $# -gt 0 ]; do
    case "${1}" in
        --project)   project="${2:-}"; shift 2 ;;
        --dir)       issue_dir="${2:-}"; issue_dir_given=1; shift 2 ;;
        --fetch-only) fetch_only=1; shift ;;
        -h|--help)   usage; exit 0 ;;
        -*)          plugin_say "unknown option '${1}'"; usage; exit 2 ;;
        *)
            [ -z "${key}" ] || { plugin_say "one issue at a time (got '${key}' and '${1}')"; exit 2; }
            key="${1}"; shift ;;
    esac
done

[ -n "${key}" ] || { usage; exit 2; }

# Upper-case, then check. JIRA keys are upper-case and the API is case-sensitive
# about them; accepting "as-345" and fixing it is kinder than a 404. The pattern
# is also what makes the key safe to put in a URL and in a filename.
key="$(printf '%s' "${key}" | tr '[:lower:]' '[:upper:]')"
case "${key}" in
    [A-Z]*-[0-9]*)
        [[ "${key}" =~ ^[A-Z][A-Z0-9_]*-[0-9]+$ ]] || { plugin_die "'${key}' is not an issue key (expected something like AS-345)"; } ;;
    *) plugin_die "'${key}' is not an issue key (expected something like AS-345)" ;;
esac

jira_require_config

# ---------------------------------------------------------------------------
# Where the work happens
# ---------------------------------------------------------------------------
project="${project:-${PWD}}"
project="$(cd -- "${project}" 2>/dev/null && pwd)" \
    || plugin_die "${project}: no such directory"

# The box only has the workspace bound in. A project outside it is not "hard to
# reach" -- it is invisible to the session that is about to be started, so the
# file would be written somewhere the agent can never open.
project_box="$(box_path "${project}")" || plugin_die \
    "${project} is outside ${BOX_WORKSPACE_HOST}, which is the only host tree the box can see"

# Claude is asked to work on a new branch, which needs a repository to branch in.
git -C "${project}" rev-parse --git-dir >/dev/null 2>&1 \
    || plugin_die "${project} is not a git repository, so there is no branch to create"

# Not fatal: plenty of people triage with work in progress. But a session that
# creates a branch over a dirty tree drags those changes onto it, and that is
# worth knowing before it happens rather than afterwards.
if [ -n "$(git -C "${project}" status --porcelain 2>/dev/null)" ]; then
    plugin_say "warning: ${project} has uncommitted changes; a new branch will carry them along"
fi

jira_config_load
[ -n "${issue_dir_given}" ] || issue_dir="${JIRA_ISSUE_DIR:-}"
case "${issue_dir}" in
    "")  target_dir="${project}" ;;
    /*)  target_dir="${issue_dir%/}" ;;
    *)   target_dir="${project}/${issue_dir%/}" ;;
esac
mkdir -p -- "${target_dir}" || plugin_die "cannot create ${target_dir}"
target_dir="$(cd -- "${target_dir}" && pwd)"
box_path "${target_dir}" >/dev/null || plugin_die \
    "${target_dir} is outside ${BOX_WORKSPACE_HOST}, so the box could not read the file there"

issue_file="${target_dir}/${key}.md"

# How the file would be named from claude's working directory, which is the
# project. Only used if the issue turns out to be too big to inline; see below.
issue_rel="${issue_file#"${project}"/}"

# ---------------------------------------------------------------------------
# Fetch, on this machine
# ---------------------------------------------------------------------------
plugin_say "fetching ${key} from ${JIRA_URL}"
issue_json="$(jira_api "/rest/api/3/issue/${key}?fields=summary,description,issuetype,status,priority,reporter,created")" \
    || exit 1

# Render with whatever node is available.
#
# The host's is the normal path. The fallback matters more than it looks: node
# is often installed through nvm, which puts it on PATH only in a shell that
# sourced nvm, and the launcher assumes elsewhere that a host may have no node
# at all. The box's node 22 is always there, and the issue text is going into
# the box in the next step regardless, so nothing is exposed by using it. The
# token is not involved either way -- this is formatting, on JSON already
# fetched.
render_issue() {
    if command -v node >/dev/null 2>&1; then
        node "${CLAUDEBOX_PLUGIN_DIR}/lib/render-issue.js"
    elif box_running; then
        docker exec -i "${CLAUDEBOX_CONTAINER}" \
            node -e "$(cat "${CLAUDEBOX_PLUGIN_DIR}/lib/render-issue.js")"
    else
        plugin_say "no node on this machine and the box is not running, so there is nothing"
        plugin_say "to render the issue with. Install node, or start the box ('claudebox')"
        plugin_say "and run this again."
        return 1
    fi
}

# Via a temporary file in the same directory, so a failed render leaves the
# previous <KEY>.md intact instead of truncating it.
tmp_file="$(mktemp "${issue_file}.XXXXXX")"
trap 'rm -f -- "${tmp_file}"' EXIT
if ! printf '%s' "${issue_json}" | render_issue > "${tmp_file}"; then
    exit 1
fi
chmod 0644 "${tmp_file}"
mv -- "${tmp_file}" "${issue_file}"
trap - EXIT
plugin_say "wrote ${issue_file}"

if [ -n "${fetch_only}" ]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# Triage, in the box
# ---------------------------------------------------------------------------

# Through the launcher, not box_exec: starting a session is also the workspace
# checks, the dind AppArmor preflight, the allowlist resync and the DDEV
# hostname rewrite, and a session started around those is a session in a box
# that is only almost right. Running it from the project directory is what puts
# claude in that project's counterpart inside the box.
# The issue goes into the prompt ITSELF rather than as a path to open.
#
# It saves the session a tool call, and more usefully it makes the run
# self-contained: the agent has the whole report before it starts, rather than a
# filename it has to decide to read. The file is still written -- it is the
# thing you asked for, and --fetch-only produces nothing else -- but nothing in
# the prompt depends on it any more.
#
# Delimited by a tag rather than a fenced block, because the issue is markdown
# and routinely contains fences of its own; a fence here would end at the first
# one in a stack trace and the rest of the report would read as instructions.
issue_text="$(cat -- "${issue_file}")"
issue_bytes="$(wc -c < "${issue_file}" | tr -d ' ')"

# execve caps a SINGLE argument at 128KB (MAX_ARG_STRLEN), and a prompt is one
# argument. Past that the failure is "docker: Argument list too long" from the
# client, which says nothing about issues or prompts -- so measure first and
# degrade on purpose. The margin is for the wrapper text and for the fact that
# this is bytes, not characters.
#
# There are two ways to degrade and which is right depends on where the session
# will run, so both are below.
prompt_max=100000
prompt_head="Below is a description of a possible bug or vulnerability. please read it, verify if the issue is real, and if it is, on a new branch based of the repository's default branch, create a failing regression test for it. do not commit any changes, and make sure the branch name does not mention tests (it will be used to fix the issue later)"

wrap_issue() {
    printf '%s\n\n<issue key="%s">\n%s\n</issue>' "${prompt_head}" "${key}" "${1}"
}

if [ "${issue_bytes}" -le "${prompt_max}" ]; then
    prompt="$(wrap_issue "${issue_text}")"
elif runner_hosted_here; then
    # Too big to inline, and this machine hosts a runner -- so the session will
    # be answered on the WORKSTATION while this file sits here. Naming it would
    # point the agent at a path that does not exist over there, so send what
    # fits and say plainly that the tail was cut. Issues get large because of a
    # pasted log or dump, which is at the end; the report itself is at the top.
    plugin_say "${key} is ${issue_bytes} bytes; sending the first ${prompt_max} -- the run goes to"
    plugin_say "another machine, so pointing at ${issue_rel} here would be pointing at nothing"
    prompt="$(wrap_issue "$(head -c "${prompt_max}" -- "${issue_file}")
[truncated: the issue is ${issue_bytes} bytes and only the first ${prompt_max} are above]")"
else
    # Too big to inline, and the session runs on this machine, so the file it
    # was written to is right there. Naming it loses nothing.
    plugin_say "${key} is ${issue_bytes} bytes, too large to put in the prompt; pointing at the file instead"
    prompt="In the ${issue_rel}, there is a description of a possible bug or vulnerability. please read the file, verify if the issue is real, and if it is, on a new branch, create a failing regression test for it."
fi

log_dir="$(plugin_state)/runs"
mkdir -p -- "${log_dir}"
log_file="${log_dir}/${key}-$(date +%Y%m%d-%H%M%S).log"

plugin_say "starting a session in the box (auto mode); this takes a while"
plugin_say "the answer lands in ${log_file} when it finishes"

# stdout captured, stderr left alone: the launcher's own progress lines and
# claude's stderr arrive as they happen, while the answer is held back to be
# printed in one piece at the end. Capturing stdout also means it is not a
# terminal, so the launcher attaches no tty -- which is what makes this safe to
# run non-interactively.
#
# WHY THERE IS A HEARTBEAT
#
# "claude -p" is print mode: it emits its answer when it finishes and nothing
# before that. Capturing it here holds that back further. So a triage of a
# substantial issue is several minutes of complete silence, which is
# indistinguishable from a hang -- and when the run has been forwarded to
# another machine, there is not even a local process to look at. A line every
# thirty seconds is the cheapest thing that answers "is this still going".
#
# It goes to stderr, so a caller capturing this command's stdout still gets the
# answer and nothing else.
answer_file="$(mktemp)"
cleanup_run() { rm -f -- "${answer_file}"; }
trap cleanup_run EXIT

set +e
# Job control on, so the run gets a process group of its own and can be stopped
# as a whole. Without it there is a chain here -- subshell, launcher, and either
# a "docker exec" or the "docker run" that carries a forwarded request -- and
# killing only the first leaves the rest of it going.
set -m
( cd "${project}" && "${CLAUDEBOX_DIR}/claudebox" \
    -p "${prompt}" --permission-mode auto </dev/null > "${answer_file}" ) &
run_pid=$!
set +m

# Ctrl-C should stop the session, not just stop waiting for it -- an auto-mode
# agent left running is one making commits with nobody reading them.
#
# Two steps, because the local and forwarded cases end differently. Killing the
# process group ends the chain here, and for a FORWARDED run that is enough: the
# request's connection drops, and agent-serve.mjs on the other machine kills its
# child when that happens. For a LOCAL run it is not enough -- "docker exec"
# does not pass a signal to the process it started, so claude carries on in the
# box. It is found by the issue key in its prompt, which is unique to this run.
stop_run() {
    kill -- -"${run_pid}" 2>/dev/null
    if box_running; then
        docker exec "${CLAUDEBOX_CONTAINER}" sh -c \
            "ps -eo pid,args | grep '<issue key=\"${key}\">' | grep -v grep | awk '{print \$1}' | xargs -r kill" \
            2>/dev/null || true
    fi
}
trap 'echo >&2; plugin_say "stopping the session"; stop_run; cleanup_run; exit 130' INT TERM

run_started="$(date +%s)"
while kill -0 "${run_pid}" 2>/dev/null; do
    sleep 5
    kill -0 "${run_pid}" 2>/dev/null || break
    elapsed=$(( $(date +%s) - run_started ))
    # Every 30s, not every 5: the loop wakes often so that finishing is noticed
    # promptly, but says so rarely enough not to become the noise it is meant to
    # replace.
    if [ $(( elapsed % 30 )) -lt 5 ] && [ "${elapsed}" -ge 30 ]; then
        plugin_say "still running ($(printf '%dm%02ds' $(( elapsed / 60 )) $(( elapsed % 60 )))) -- 'claudebox ps' on the machine running it shows what it is doing"
    fi
done
wait "${run_pid}"
status=$?
trap - INT TERM
set -e

answer="$(cat -- "${answer_file}")"
printf '%s\n' "${answer}" > "${log_file}"

if [ -n "${answer}" ]; then
    echo
    printf '%s\n' "${answer}"
fi

if [ "${status}" -ne 0 ]; then
    plugin_say "the session exited ${status}"
    exit "${status}"
fi

plugin_say "done. 'git -C ${project} branch' shows what it created, if anything"
