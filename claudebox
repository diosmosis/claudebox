#!/usr/bin/env bash
#
# Run Claude Code inside the isolated claudebox container.
#
#   claudebox                 start an interactive session in the current directory
#   claudebox -p 'summarise'  pass any flags/prompt straight through to claude
#   claudebox opencode [args] run opencode in the box instead of claude
#   claudebox shell           drop into bash inside the box instead
#   claudebox rebuild         rebuild the image after editing the Dockerfile
#   claudebox stop            stop the box (state in the home volume survives)
#
#   claudebox media add <p>   copy material off a drive into the box's /media
#   claudebox media ls        list what is staged there
#   claudebox media rm <n>    drop a staged entry
#
#   claudebox allow <domain>  permit a domain and reload the proxy
#   claudebox reload          re-apply allowlist.conf after a manual edit
#   claudebox allowed         show the egress allowlist
#   claudebox denied          show requests the proxy has blocked
#
#   claudebox plugins         list the commands plugins add
#   claudebox <p>:<cmd> ...   run one (plugins/<p>/commands/<cmd>)
#
#   claudebox agent ...       the inbound agent door: serve one here, or (on a
#                             machine hosting a runner) join one elsewhere
#
# Env overrides: BOX_WORKSPACE, BOX_WORKSPACE_HOST, BOX_USER, BOX_HOST_HOME,
#               BOX_MKCERT_CA, BOX_PLUGIN_PATH,
#               BOX_DDEV_PROJECT (which project's database is reachable as db:3306)
set -euo pipefail

# Resolve symlinks first: this script is normally invoked via ~/.local/bin, and
# ${BASH_SOURCE[0]} is the path as invoked, not the real file. Without
# readlink -f, BOX_DIR points at the symlink's directory and every path built
# from it (compose file, allowlist) is wrong.
BOX_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
CONTAINER=claudebox
PROXY=claudebox-proxy
ALLOWLIST="${BOX_DIR}/allowlist.conf"
# Bind-mounted read-only at /media in the box (see docker-compose.yaml).
MEDIA_DIR="${BOX_DIR}/media"
# Both compose files, named explicitly. Passing -f at all turns OFF Compose's
# automatic discovery of docker-compose.override.yaml, so it has to be listed by
# hand -- otherwise the launcher-generated mounts (plans, optional gitconfig) are
# written to a file nothing ever reads.
COMPOSE=(docker compose \
    -f "${BOX_DIR}/docker-compose.yaml" \
    -f "${BOX_DIR}/docker-compose.override.yaml")

# The rootless dind sidecar's AppArmor prerequisite, checked before the stack
# starts and diagnosed from the sidecar's log if it fails anyway. Shared with
# the runner launcher so both print the same fix; see dind-apparmor.sh.
DIND_APPARMOR_TAG=claudebox
DIND_APPARMOR_DIR="${BOX_DIR}"
DIND_APPARMOR_CONTAINER=claudebox-dind
# shellcheck source=dind-apparmor.sh
. "${BOX_DIR}/dind-apparmor.sh"

# The half of this launcher that plugin commands also need: path translation,
# the flags a session is attached with, and the small vocabulary a plugin talks
# to the box in. Sourced here rather than copied there so there is one
# implementation; exported below so a plugin, which is a separate process, can
# source the same file. Functions only, so sourcing it this early is safe --
# nothing in it reads a setting until it is called.
# shellcheck source=plugin-api.sh
export CLAUDEBOX_PLUGIN_API="${BOX_DIR}/plugin-api.sh"
export CLAUDEBOX_DIR="${BOX_DIR}"
export CLAUDEBOX_CONTAINER="${CONTAINER}"
export CLAUDEBOX_PROXY_CONTAINER="${PROXY}"
# Newline-separated, because an array cannot be exported. box_compose in the API
# turns it back into "-f <file>" pairs.
export CLAUDEBOX_COMPOSE_FILES="${BOX_DIR}/docker-compose.yaml
${BOX_DIR}/docker-compose.override.yaml"
# shellcheck source=/dev/null
. "${CLAUDEBOX_PLUGIN_API}"

# ---------------------------------------------------------------------------
# Settings file
#
# ~/.claudebox/config, sourced as shell. It holds the settings that describe
# THIS machine -- most of all which host directory is the workspace, which is
# not something to retype or keep in a shell profile when the answer is a
# property of the box.
#
# The environment still wins, so a one-off stays a one-off:
#   BOX_WORKSPACE_HOST=/mnt/other claudebox
# works even when the file says otherwise. That is the whole reason for the
# save/restore below rather than sourcing and hoping: a sourced assignment is
# unconditional and would silently beat the command line.
#
# Only the names listed here are honoured. A file is a poor place to discover
# that a setting was misspelled, and enumerating them means "claudebox config"
# can print exactly what is settable.
# ---------------------------------------------------------------------------
BOX_CONFIG="${BOX_CONFIG:-${BOX_DIR}/config}"
BOX_SETTINGS=(
    BOX_WORKSPACE BOX_WORKSPACE_HOST
    BOX_USER BOX_UID BOX_GID BOX_HOST_HOME
    BOX_MKCERT_CA BOX_DDEV_PROJECT BOX_DIND_APPARMOR
    BOX_RUNNER BOX_RUNNER_TOKEN BOX_RUNNER_FINGERPRINT
    BOX_AGENT BOX_AGENT_TOKEN BOX_AGENT_FINGERPRINT
    BOX_AGENT_SERVE BOX_AGENT_PORT
    BOX_PLUGIN_PATH
)
if [ -f "${BOX_CONFIG}" ]; then
    declare -A _from_env=()
    for _s in "${BOX_SETTINGS[@]}"; do
        # ${!v+set} distinguishes "unset" from "set but empty" -- an empty value
        # in the environment is still a deliberate one.
        if [ -n "${!_s+set}" ]; then
            _from_env["${_s}"]="${!_s}"
        fi
    done
    # shellcheck source=/dev/null
    . "${BOX_CONFIG}" || {
        echo "claudebox: ${BOX_CONFIG} failed to parse; fix it or move it aside" >&2
        exit 2
    }
    for _s in "${!_from_env[@]}"; do
        printf -v "${_s}" '%s' "${_from_env[${_s}]}"
    done
    unset _s _from_env
fi

# The workspace has two paths, and they are only the same by default.
#
# BOX_WORKSPACE is where the box sees the source tree; BOX_WORKSPACE_HOST is the
# directory on the host that is bound there. Keeping them equal is what makes
# paths the box prints clickable on the host, so BOX_WORKSPACE_HOST defaults to
# BOX_WORKSPACE and everything stays 1:1 unless it is set.
#
# Set BOX_WORKSPACE_HOST alone to keep the tree somewhere else -- an external or
# removable drive, say -- while the box still sees a plain ~/Projects. Doing it
# the other way round, by pointing BOX_WORKSPACE at the drive so both sides
# match, works too, but the box then carries the drive's path everywhere and a
# mount point under /media collides with the box's own staged-material mount.
#
# Two things to know before moving the workspace onto a removable drive:
#   - The path has to be on Docker Desktop's file-sharing list, which by default
#     here is /home only. require_workspace below checks this and says what to
#     do; without it the container refuses to start.
#   - A shared host path is pinned by the VM's virtiofsd for as long as Docker
#     Desktop runs, so the drive cannot be ejected until Desktop is quit -- the
#     reason /media in the box is staged copies instead of the real drives. For
#     material only to be read from, "claudebox media add" is the better tool;
#     this is for a tree to work in.
export BOX_WORKSPACE="${BOX_WORKSPACE:-${HOME}/Projects}"
export BOX_WORKSPACE_HOST="${BOX_WORKSPACE_HOST:-${BOX_WORKSPACE}}"
# Strip a trailing slash from each: they are compared and concatenated as string
# prefixes below, where "/x/" and "/x" would not match.
BOX_WORKSPACE="${BOX_WORKSPACE%/}"
BOX_WORKSPACE_HOST="${BOX_WORKSPACE_HOST%/}"
for _ws_var in BOX_WORKSPACE BOX_WORKSPACE_HOST; do
    # Compose reads a relative volume source as a NAMED VOLUME, not a path, so a
    # relative setting here would come up as an empty tree rather than an error.
    case "${!_ws_var}" in
        /?*) ;;
        *)
            echo "claudebox: ${_ws_var} must be an absolute path (got '${!_ws_var}')" >&2
            exit 2
            ;;
    esac
done
unset _ws_var
export BOX_HOST_HOME="${BOX_HOST_HOME:-${HOME}}"
export BOX_USER="${BOX_USER:-$(id -un)}"
export BOX_UID="${BOX_UID:-$(id -u)}"
export BOX_GID="${BOX_GID:-$(id -g)}"
export BOX_MKCERT_CA="${BOX_MKCERT_CA:-$(mkcert -CAROOT 2>/dev/null || echo "${HOME}/.local/share/mkcert")/rootCA.pem}"

# Where "claudebox <plugin>:<command>" looks, colon-separated, earliest wins.
#
# One default: plugins/ beside this script, which is tracked and holds the
# plugins claudebox ships. A plugin there is a command that arrives with the
# tool and is reviewed, versioned and rebuilt with it, rather than something
# each machine grows its own copy of.
#
# The setting exists for the case that is not that -- a plugin kept in its own
# checkout, or one local to a machine and not meant for the repository. Adding a
# directory rather than replacing this one means listing both:
#   BOX_PLUGIN_PATH="${HOME}/my-plugins:${BOX_DIR}/plugins"
export BOX_PLUGIN_PATH="${BOX_PLUGIN_PATH:-${BOX_DIR}/plugins}"

# The remote test runner, if one has been joined: address, shared token and the
# certificate fingerprint to pin. These go to runner-relay and ONLY to
# runner-relay -- never into the box's own environment, which is the entire
# point of having a relay. Empty is a normal state: the relay then answers the
# box with the join instructions instead of a connection error.
# The inbound agent door, both halves.
#
# On a WORKSTATION: BOX_AGENT_SERVE=1 turns on the front door (agent-relay) and
# the box's listener behind it, so a machine that hosts a runner can send its
# headless one-offs here. BOX_AGENT_PORT is where it is published.
#
# On a RUNNER MACHINE: BOX_AGENT / _TOKEN / _FINGERPRINT are the workstation
# that was joined with "claudebox agent add", and are the mirror of the
# BOX_RUNNER trio above -- an address, a bearer token and a pinned certificate.
# They go to a one-off container from the agent-relay image and nowhere else;
# the box on this machine never runs, so nothing here is in its environment.
export BOX_AGENT="${BOX_AGENT:-}"
export BOX_AGENT_TOKEN="${BOX_AGENT_TOKEN:-}"
export BOX_AGENT_FINGERPRINT="${BOX_AGENT_FINGERPRINT:-}"
export BOX_AGENT_SERVE="${BOX_AGENT_SERVE:-}"
export BOX_AGENT_PORT="${BOX_AGENT_PORT:-7996}"

# The front door is behind a compose profile, so a claudebox that was not asked
# for one never creates the service and never publishes a port. This is the only
# thing that turns it on.
if [ -n "${BOX_AGENT_SERVE}" ]; then
    COMPOSE+=(--profile agent)
fi

export BOX_RUNNER="${BOX_RUNNER:-}"
export BOX_RUNNER_TOKEN="${BOX_RUNNER_TOKEN:-}"
export BOX_RUNNER_FINGERPRINT="${BOX_RUNNER_FINGERPRINT:-}"

# Which DDEV project's database the box reaches at "db:3306" (see the ddev-db
# service). Auto-detected when exactly one project is running -- with several up
# there is no defensible guess, so it stays unset and the bridge points at a
# name that does not resolve. Pin it with BOX_DDEV_PROJECT to override either
# case. Resolved before the command dispatch below so "rebuild" sees it too.
if [ -z "${BOX_DDEV_PROJECT:-}" ] && command -v ddev >/dev/null 2>&1; then
    ddev_running="$(ddev list -j 2>/dev/null \
        | jq -r '.raw[]? | select((.status // "") == "running") | .name' 2>/dev/null || true)"
    ddev_count="$(printf '%s\n' "${ddev_running}" | grep -c . || true)"
    if [ "${ddev_count}" = "1" ]; then
        BOX_DDEV_PROJECT="$(printf '%s\n' "${ddev_running}" | head -1)"
    fi
fi
export BOX_DDEV_PROJECT="${BOX_DDEV_PROJECT:-none}"

# Regenerate the compose override before any command runs, so "stop"/"rebuild"
# and the launch path below all act on the same, present file. It always carries
# the plans bind; optional host files are added only when they exist -- binding a
# missing path would make Docker create a directory in the host home directory.
mounts=()

# Expose the box's plans directory on the host. The rest of the box's ~/.claude
# stays on the private home volume; plans are the one part shared out, so
# plan-mode output written inside the box can be read and edited on the host.
# ~/.claude/plans is where Claude writes plans; the host side sits in the
# project dir, keeping box state out of the host's own ~/.claude. This bind is
# nested deeper than the home volume, so Docker layers it on top. mkdir first
# for the same reason the file mounts are guarded: a missing path is created
# root-owned.
mkdir -p "${BOX_DIR}/plans"
mounts+=("${BOX_DIR}/plans:/home/${BOX_USER}/.claude/plans")

# The staging directory for /media. Its bind lives in docker-compose.yaml, not
# in the override, but it needs the same guard: Docker creates a missing bind
# source as a root-owned directory, and then nothing here can write to it.
mkdir -p "${MEDIA_DIR}"

if [ -f "${BOX_HOST_HOME}/.gitconfig" ]; then
    mounts+=("${BOX_HOST_HOME}/.gitconfig:/host/gitconfig:ro")
fi

# opencode's host config and credentials, read-only, for entrypoint.sh to seed
# the box's own copies from on first start. Conditional because opencode need
# not be installed on the host at all -- and because binding a path that does
# not exist would have Docker create it, root-owned, in the host home directory.
#
# Credentials are a separate mount: opencode keeps its config under ~/.config
# and its tokens under ~/.local/share, and only the latter is a secret. Nothing
# reads either after the first start, so the file mount going stale when
# opencode rewrites the host's auth.json (a replaced inode, see the allowlist
# note below) does not matter here.
if [ -d "${BOX_HOST_HOME}/.config/opencode" ]; then
    mounts+=("${BOX_HOST_HOME}/.config/opencode:/host/opencode:ro")
fi
if [ -f "${BOX_HOST_HOME}/.local/share/opencode/auth.json" ]; then
    mounts+=("${BOX_HOST_HOME}/.local/share/opencode/auth.json:/host/opencode-auth.json:ro")
fi
{
    printf 'services:\n  claude:\n    volumes:\n'
    printf '      - %s\n' "${mounts[@]}"
} > "${BOX_DIR}/docker-compose.override.yaml"

# Refuse to bring the box up against a workspace that is not really there.
#
# Every failure below is one Docker reports late and badly, or not at all: a
# missing bind source is silently created (root-owned, and on a removable drive's
# mount point that also means writing to the internal disk under it), and a host
# path outside Docker Desktop's file-sharing list stops the container from
# starting with an error that names the path but not the setting.
# ---------------------------------------------------------------------------
# Bring the stack up, and say what went wrong when it does not
#
# The box depends_on dind being healthy, so a sidecar that cannot start surfaces
# here as compose's "dependency failed to start" -- which names the service and
# nothing else. Ask the sidecar's own log first; on this host there is one
# answer it gives often enough to be worth recognising by hand.
# ---------------------------------------------------------------------------
compose_up() {
    dind_apparmor_preflight
    if "${COMPOSE[@]}" up -d "$@"; then
        return 0
    fi
    dind_apparmor_postmortem || true
    exit 1
}

require_workspace() {
    local store shared entry ok=""

    if [ ! -d "${BOX_WORKSPACE_HOST}" ]; then
        echo "claudebox: workspace ${BOX_WORKSPACE_HOST} does not exist (or is not a directory)" >&2
        if [ "${BOX_WORKSPACE_HOST}" != "${BOX_WORKSPACE}" ]; then
            echo "claudebox: it is set by BOX_WORKSPACE_HOST -- if that is a removable drive, mount it first." >&2
        fi
        exit 1
    fi

    # An empty workspace is legitimate on a first run, so this is a warning. It
    # is also exactly what an unmounted drive's mount point looks like, and the
    # box coming up over one is a session that quietly sees no projects.
    if [ -z "$(ls -A -- "${BOX_WORKSPACE_HOST}" 2>/dev/null)" ]; then
        echo "claudebox: warning: ${BOX_WORKSPACE_HOST} is empty; the box will see no projects" >&2
    fi

    # Docker Desktop exports only the host paths on its file-sharing list into
    # the engine VM. Anything else fails at container create with "mounts
    # denied", one layer below this script. Advisory: if the list cannot be read
    # (no jq) the check is skipped rather than guessed at.
    #
    # Gated on the ACTIVE CONTEXT, not on the settings file existing: a native
    # dockerd binds host paths directly and shares nothing, so the list means
    # nothing to it -- and the file outlives Docker Desktop on a host that has
    # moved off it, which would otherwise leave this rejecting perfectly good
    # paths for a reason that no longer applies.
    store="${BOX_HOST_HOME}/.docker/desktop/settings-store.json"
    if [ ! -f "${store}" ] || ! command -v jq >/dev/null 2>&1; then
        return 0
    fi
    case "$(docker context inspect -f '{{.Endpoints.docker.Host}}' 2>/dev/null || true)" in
        *"/.docker/desktop/docker.sock") ;;
        *) return 0 ;;
    esac
    shared="$(jq -r '.FilesharingDirectories[]?' "${store}" 2>/dev/null || true)"
    if [ -z "${shared}" ]; then
        return 0
    fi
    while IFS= read -r entry; do
        entry="${entry%/}"
        case "${BOX_WORKSPACE_HOST}" in
            "${entry}"|"${entry}"/*) ok=1; break ;;
        esac
    done <<< "${shared}"
    if [ -n "${ok}" ]; then
        return 0
    fi

    echo "claudebox: ${BOX_WORKSPACE_HOST} is not shared with Docker Desktop, so the box cannot" >&2
    echo "claudebox: start over it. Shared now: $(printf '%s' "${shared}" | tr '\n' ' ')" >&2
    echo "claudebox: Add it in Docker Desktop > Settings > Resources > File sharing, then" >&2
    echo "claudebox: 'Apply & restart'. Note what that costs: a shared path is held open by" >&2
    echo "claudebox: the VM's virtiofsd for as long as Docker Desktop runs, so a drive shared" >&2
    echo "claudebox: this way cannot be ejected until Desktop is quit. For material you only" >&2
    echo "claudebox: need to read, 'claudebox media add <path>' copies it in and keeps the" >&2
    echo "claudebox: drive ejectable." >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Point DDEV hostnames at ddev-router
#
# *.ddev.site resolves to 127.0.0.1 in public DNS, which inside a container is
# the container itself. These entries go in the PROXY, not the box: the box has
# no resolver of its own, so it sends "CONNECT matomo.ddev.site:443" and the
# proxy is what has to turn that name into an address. Rewritten on every launch
# so the box tracks projects as they start and stop -- and again after any
# restart of the proxy, which wipes them along with the rest of its /etc/hosts.
# ---------------------------------------------------------------------------
write_ddev_hosts() {
    local quiet="${1:-}"
    local router_ip names hosts_line=""

    router_ip="$(docker inspect -f \
        '{{ with index .NetworkSettings.Networks "ddev_default" }}{{ .IPAddress }}{{ end }}' \
        ddev-router 2>/dev/null || true)"

    if [ -n "${router_ip}" ] && command -v ddev >/dev/null 2>&1; then
        names="$(ddev list -j 2>/dev/null \
            | jq -r '[.raw[]? | select((.status // "") == "running")
                     | (.name + "." + (.project_tld // "ddev.site")),
                       (.httpsurl // empty), (.httpurl // empty), (.urls[]? // empty)]
                     | .[]' 2>/dev/null \
            | sed -E 's#^https?://##; s#[:/].*$##' \
            | grep -E '^[A-Za-z0-9.-]+\.[A-Za-z]+$' \
            | sort -u | tr '\n' ' ' || true)"
        # ddev-router outlives the last project it served, so an existing router
        # IP does not imply there is anything to map.
        if [ -n "${names% }" ]; then
            hosts_line="${router_ip} ${names}"
        fi
    fi

    # /etc/hosts is a bind mount inside the container, so "sed -i" (which renames
    # a temp file over the target) fails with EBUSY. Read it, then truncate in
    # place.
    docker exec -u 0 "${PROXY}" bash -c '
        kept="$(grep -v "# claudebox$" /etc/hosts || true)"
        {
            printf "%s\n" "$kept"
            [ -n "$1" ] && printf "%s # claudebox\n" "$1"
        } > /etc/hosts
        exit 0
    ' _ "${hosts_line}" 2>/dev/null || true

    if [ "${quiet}" = "quiet" ]; then
        return 0
    fi
    if [ -n "${hosts_line}" ]; then
        echo "claudebox: reachable DDEV sites -> ${hosts_line#* }" >&2
    else
        echo "claudebox: no running DDEV projects detected" >&2
    fi
}

# Prepare the bridged project's web container for UI tests (client IP, path
# alias). Both live in that container's filesystem, so a `ddev restart` discards
# them and they have to be re-applied -- doing it here means every session the
# launcher starts begins in a known-good state.
#
# The work itself is claudebox-ddev-fixups in the box, deliberately the same code
# path the box's Claude uses to repair a mid-session restart: if it works here it
# works there. Never fatal -- a box that comes up without this is still a usable
# box, it just cannot produce CI-comparable screenshots, so say so and continue.
apply_ddev_fixups() {
    local approot boxroot
    if [ "${BOX_DDEV_PROJECT}" = "none" ]; then
        return 0
    fi
    approot="$(ddev list -j 2>/dev/null \
        | jq -r --arg p "${BOX_DDEV_PROJECT}" \
            '.raw[]? | select(.name == $p) | .approot' 2>/dev/null \
        | head -1 || true)"
    if [ -z "${approot}" ] || [ ! -d "${approot}" ]; then
        echo "claudebox: could not locate ${BOX_DDEV_PROJECT}'s directory; skipped web-container setup" >&2
        return 0
    fi
    # approot is a host path; the fixups run in the box, which sees the project
    # under its own workspace root. Outside the workspace it is not visible in
    # there at all, and there is nothing to run the fixups against.
    if ! boxroot="$(box_path "${approot}")"; then
        echo "claudebox: ${BOX_DDEV_PROJECT} is at ${approot}, outside the workspace" >&2
        echo "claudebox: (${BOX_WORKSPACE_HOST}); skipped web-container setup" >&2
        return 0
    fi
    if docker exec -u "${BOX_UID}:${BOX_GID}" -w "${boxroot}" "${CONTAINER}" \
            claudebox-ddev-fixups >/dev/null 2>&1; then
        echo "claudebox: ${BOX_DDEV_PROJECT} web container ready for UI tests (client IP, path alias)" >&2
    else
        echo "claudebox: could NOT prepare ${BOX_DDEV_PROJECT}'s web container -- screenshots will not" >&2
        echo "claudebox: match CI. In the box: cd ${boxroot} && claudebox-ddev-fixups" >&2
    fi
}

wait_for_proxy() {
    local i
    for i in $(seq 1 60); do
        if [ "$(docker inspect -f '{{ .State.Health.Status }}' "${PROXY}" 2>/dev/null)" = "healthy" ]; then
            return 0
        fi
        sleep 0.5
    done
    return 1
}

# The allowlist is a single bind-mounted FILE, and an in-place edit on the host
# does not reliably reach the container: Docker Desktop's file-sharing layer can
# keep serving the old contents. Reloading does not help, because a reload
# re-reads the file from inside the container, which is where the stale copy is.
# Observed for real: the host file was 35 bytes longer than the container's view
# of the same inode, and "claudebox allow" reported success while the domain
# stayed blocked.
#
# Compare the two views by content. Only a restart remounts the file.
allowlist_in_sync() {
    local host_sum box_sum
    host_sum="$(md5sum < "${ALLOWLIST}" 2>/dev/null | cut -d' ' -f1)"
    box_sum="$(docker exec "${PROXY}" md5sum /etc/squid/allowlist.conf 2>/dev/null | cut -d' ' -f1)"
    # Proxy down or file unreadable: nothing to compare, let the caller carry on.
    if [ -z "${host_sum}" ] || [ -z "${box_sum}" ]; then
        return 0
    fi
    [ "${host_sum}" = "${box_sum}" ]
}

# Remount a stale allowlist. Returns non-zero only if the container still
# disagrees with the host afterwards.
resync_allowlist() {
    echo "claudebox: the proxy is holding a stale allowlist.conf; remounting" >&2
    if ! docker restart "${PROXY}" >/dev/null 2>&1; then
        echo "claudebox: could not restart the proxy" >&2
        return 1
    fi
    wait_for_proxy || true
    # A restart resets the proxy's /etc/hosts along with everything else.
    write_ddev_hosts quiet
    if allowlist_in_sync; then
        return 0
    fi
    echo "claudebox: the proxy still sees a different allowlist.conf than the host." >&2
    echo "claudebox: recreate it with 'claudebox rebuild' to remount the file." >&2
    return 1
}

# Re-expand allowlist.conf into the ACL files squid reads and apply them. The
# allowlist is bind-mounted, so this never needs a rebuild.
#
# "allowlist reload" exits 3 when the new list would not parse: it has already
# rolled back to the previous one, and restarting the proxy at that point would
# rebuild from the same bad source and leave the box with no egress at all. So
# only fall back to a restart for other failures.
reload_proxy() {
    local rc=0

    # Do this first: reloading a stale file just re-applies the old list and
    # reports success, which is worse than failing.
    if ! allowlist_in_sync; then
        if ! resync_allowlist; then
            return 1
        fi
        # The container's start-up build can read the mount before the refresh
        # lands, so always re-expand after a remount rather than trusting it.
    fi

    docker exec "${PROXY}" allowlist reload || rc=$?
    case "${rc}" in
        0)
            echo "claudebox: proxy reloaded" >&2
            ;;
        3)
            echo "claudebox: allowlist rejected; the previous one is still in force" >&2
            return 1
            ;;
        *)
            if docker restart "${PROXY}" >/dev/null 2>&1; then
                wait_for_proxy || true
                write_ddev_hosts quiet
                echo "claudebox: proxy restarted" >&2
            else
                echo "claudebox: proxy not running; the change applies at next start" >&2
            fi
            ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Staged media
#
# ~/.claudebox/media is what the box sees as /media, read-only. Material is
# copied in from a removable drive rather than the drive being mounted through,
# so the drive can be ejected at any time -- docker-compose.yaml has the reason
# in full. The box sees additions immediately; no restart, no recreate.
# ---------------------------------------------------------------------------

# Resolve a staged entry's path, rejecting anything that is not a plain name
# directly inside the staging directory. "media rm" deletes recursively, and a
# name of "../Projects" would delete something else entirely.
media_entry_path() {
    case "${1}" in
        ""|.|..|*/*) return 1 ;;
    esac
    printf '%s\n' "${MEDIA_DIR}/${1}"
}

media_usage() {
    cat >&2 <<'USAGE'
usage: claudebox media [ls]                list staged material
       claudebox media add <path>...       copy a file or directory in
       claudebox media rm <name>...        delete a staged entry

"add" names each entry after the thing it copied, so
  claudebox media add /media/dizzy/transfer/archive.zip
is /media/archive.zip in the box. Re-running "add" on the same source
refreshes that entry in place.
USAGE
}

media_list() {
    local entry found=""
    for entry in "${MEDIA_DIR}"/*; do
        # An unmatched glob comes back as the pattern itself.
        [ -e "${entry}" ] || continue
        found=1
        printf '%s\t%s\n' \
            "$(du -sh -- "${entry}" | cut -f1)" "$(basename -- "${entry}")"
    done
    if [ -z "${found}" ]; then
        echo "claudebox: nothing staged -- 'claudebox media add <path>' copies material in" >&2
        return 0
    fi
    echo "claudebox: ${MEDIA_DIR} -> /media in the box, read-only" >&2
}

media_add() {
    local src name dest need have avail
    if [ "$#" -eq 0 ]; then
        media_usage
        return 2
    fi
    for src in "$@"; do
        # Strip trailing slashes. To rsync "dir/" means the CONTENTS of dir, and
        # unpacking a drive's folder loose into the root of /media is never what
        # was meant.
        src="${src%"${src##*[!/]}"}"
        if [ ! -e "${src}" ]; then
            echo "claudebox: no such path: ${src}" >&2
            return 1
        fi
        name="$(basename -- "${src}")"
        if ! dest="$(media_entry_path "${name}")"; then
            echo "claudebox: cannot stage ${src}: no usable name for it" >&2
            return 1
        fi

        # Check the size first. The point of staging is that this directory
        # lives on the internal disk, which is also the disk everything else on
        # this host is on -- rsync discovering it is full halfway through a
        # backup drive is a worse way to find that out.
        echo "claudebox: measuring ${src}..." >&2
        need="$(du -sb -- "${src}" 2>/dev/null | cut -f1)"
        if [ -e "${dest}" ]; then
            # A refresh only pays for the difference.
            have="$(du -sb -- "${dest}" 2>/dev/null | cut -f1 || true)"
            if [ -n "${need}" ] && [ -n "${have}" ]; then
                need=$((need - have))
                [ "${need}" -lt 0 ] && need=0
            fi
        fi
        avail="$(df -B1 --output=avail "${MEDIA_DIR}" 2>/dev/null | tail -1 | tr -d ' ')"
        if [ -n "${need}" ] && [ -n "${avail}" ] && [ "${need}" -gt "${avail}" ]; then
            echo "claudebox: ${src} needs $(numfmt --to=iec "${need}") but only $(numfmt --to=iec "${avail}") is free" >&2
            echo "claudebox: on ${MEDIA_DIR}. Stage a subdirectory instead, or free space." >&2
            return 1
        fi

        if command -v rsync >/dev/null 2>&1; then
            # --no-o/--no-g: -a asks to preserve owner and group, which needs
            # root. Ownership here is meaningless anyway -- the box reads this
            # as uid 1000 and that is the only reader.
            rsync -a --no-o --no-g --info=progress2 -- "${src}" "${MEDIA_DIR}/"
        else
            # cp -a would try to preserve ownership and fail as a normal user.
            cp -r --preserve=timestamps -- "${src}" "${MEDIA_DIR}/"
        fi
        echo "claudebox: staged /media/${name}" >&2
    done
}

media_rm() {
    local name dest
    if [ "$#" -eq 0 ]; then
        media_usage
        return 2
    fi
    for name in "$@"; do
        if ! dest="$(media_entry_path "${name}")" || [ ! -e "${dest}" ]; then
            echo "claudebox: not staged: ${name}" >&2
            return 1
        fi
        rm -rf -- "${dest}"
        echo "claudebox: removed /media/${name}" >&2
    done
}

# ---------------------------------------------------------------------------
# Joining a remote test runner
#
# "claudebox runner add <host:port> <token> <fingerprint>" is the line the other
# machine's launcher prints. It stores those three values in ~/.claudebox/config
# -- the same file every other per-machine setting lives in, already gitignored
# -- and from then on the launcher hands them to runner-relay and to nothing
# else. The box never sees any of them.
# ---------------------------------------------------------------------------
config_set() {
    local key="${1}" value="${2}" tmp
    if [ ! -f "${BOX_CONFIG}" ]; then
        printf '# claudebox settings for this machine. See config.example.\n' > "${BOX_CONFIG}"
    fi
    tmp="$(mktemp "${BOX_CONFIG}.XXXXXX")"
    # Drop any existing assignment (commented or not) and re-add it at the end,
    # so re-joining a runner replaces rather than shadows.
    grep -vE "^[[:space:]]*#?[[:space:]]*${key}=" "${BOX_CONFIG}" > "${tmp}" || true
    if [ -n "${value}" ]; then
        printf '%s=%q\n' "${key}" "${value}" >> "${tmp}"
    fi
    # Tightened to 0600 rather than left at whatever it was: from here on the
    # file holds a bearer token for another machine.
    chmod 0600 "${tmp}"
    mv -- "${tmp}" "${BOX_CONFIG}"
}

runner_usage() {
    cat >&2 <<'USAGE'
usage: claudebox runner <add|show|forget|test>

  add <host:port> <code>
        Join the runner on another machine, using the eight-character enrolment
        code it printed. This is the line that machine's "claudebox-runner"
        shows when it starts.
  add <host:port> <token> <fingerprint>
        The explicit form, from "claudebox-runner join --full". Longer to type
        and trusts no certificate on sight.
  show  What is joined (the token is not printed).
  test  Ask the runner whether it is reachable, through the relay.
  forget
        Un-join. The runner keeps running; this machine stops knowing about it.

A runner is the box's environment minus the agent, on a second machine, for
running tests -- see claudebox-runner in this directory.
USAGE
}

# Trade an enrolment code for the runner's token, and pin the certificate that
# answered.
#
# Done in a one-off container from the relay image, because that is the only
# thing here with both node and a route off this machine: the box has no LAN
# access by design, and the host may have no node at all. The default bridge
# network is enough -- it NATs to the host, which is where the LAN is.
runner_enrol() {
    local addr="${1}" code="${2}" out token fp
    if ! docker image inspect claudebox-runner-relay:latest >/dev/null 2>&1; then
        echo "claudebox: building the relay image, which is what performs the join..." >&2
        "${COMPOSE[@]}" build runner-relay >/dev/null || {
            echo "claudebox: could not build claudebox-runner-relay" >&2
            return 1
        }
    fi
    out="$(docker run --rm claudebox-runner-relay:latest \
              node /app/enrol.mjs "${addr}" "${code}")" || return 1
    token="$(printf '%s\n' "${out}" | sed -n 's/^TOKEN=//p')"
    fp="$(printf '%s\n' "${out}" | sed -n 's/^FINGERPRINT=//p')"
    if [ -z "${token}" ] || [ -z "${fp}" ]; then
        echo "claudebox: the runner did not return a usable token" >&2
        return 1
    fi
    config_set BOX_RUNNER "${addr}"
    config_set BOX_RUNNER_TOKEN "${token}"
    config_set BOX_RUNNER_FINGERPRINT "${fp}"
    echo "claudebox: joined runner at ${addr}" >&2
    echo "claudebox: pinned certificate ${fp}" >&2
}

runner_cmd() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        add)
            if [ "$#" -ne 2 ] && [ "$#" -ne 3 ]; then
                echo "claudebox: runner add takes an address and either a code or a token and fingerprint" >&2
                runner_usage
                return 2
            fi
            case "${1}" in
                *:[0-9]*) ;;
                *) echo "claudebox: '${1}' is not host:port" >&2; return 2 ;;
            esac
            if [ "$#" -eq 2 ]; then
                # The short form. The relay learns the certificate on the same
                # connection it presents the code on, and pins it.
                runner_enrol "${1}" "${2}" || return 1
                echo "claudebox: relaunch claudebox to pick it up, then 'runner status' in the box" >&2
                return 0
            fi
            # The fingerprint is compared as an uppercase colon-separated hex
            # string, which is the form node reports and openssl prints. Reject
            # anything else here rather than letting it fail later as a
            # mismatch, which reads like an attack and is usually a typo.
            case "${3}" in
                *[!0-9A-Fa-f:]*|"") echo "claudebox: '${3}' is not a certificate fingerprint" >&2; return 2 ;;
            esac
            config_set BOX_RUNNER "${1}"
            config_set BOX_RUNNER_TOKEN "${2}"
            config_set BOX_RUNNER_FINGERPRINT "$(printf '%s' "${3}" | tr '[:lower:]' '[:upper:]')"
            echo "claudebox: joined runner at ${1}" >&2
            echo "claudebox: relaunch claudebox to pick it up, then 'runner status' in the box" >&2
            ;;
        show)
            if [ -z "${BOX_RUNNER}" ]; then
                echo "claudebox: no runner joined" >&2
                return 1
            fi
            echo "runner:      ${BOX_RUNNER}"
            echo "fingerprint: ${BOX_RUNNER_FINGERPRINT}"
            echo "token:       $([ -n "${BOX_RUNNER_TOKEN}" ] && echo '(set)' || echo '(missing)')"
            ;;
        forget)
            config_set BOX_RUNNER ""
            config_set BOX_RUNNER_TOKEN ""
            config_set BOX_RUNNER_FINGERPRINT ""
            echo "claudebox: runner forgotten; relaunch claudebox to apply" >&2
            ;;
        test)
            # Through the relay, exactly as the box would reach it -- so this
            # tests the pinned certificate and the token, not just a route.
            if ! docker exec claudebox-runner-relay \
                node -e "require('http').get('http://127.0.0.1:7997/health',r=>{let t='';r.on('data',d=>t+=d);r.on('end',()=>{process.stderr.write(t);process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error(e.message);process.exit(1)})"; then
                echo "claudebox: the runner did not answer. Is it running, and was the join" >&2
                echo "claudebox: line copied from its current start? A rebuilt runner has a new" >&2
                echo "claudebox: certificate and has to be re-joined." >&2
                return 1
            fi
            ;;
        *)
            runner_usage
            return 2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# The agent door
#
# Two roles, one launcher, and which one applies is decided by what is running
# on the machine rather than by a setting:
#
#   A WORKSTATION serves. With BOX_AGENT_SERVE=1 it runs agent-relay, the one
#   LAN-facing socket here, and the box runs a listener behind it.
#     claudebox agent enrol|status
#
#   A RUNNER MACHINE sends. It hosts a runner, which is the box MINUS the agent
#   on a network with no proxy and no allowlist -- the one machine deliberately
#   built not to run an agent. So it does not run one: a headless one-off goes
#   to the workstation that was joined, and everything else refuses.
#     claudebox agent add|show|test|forget
#
# The trio it stores mirrors BOX_RUNNER's exactly, in the other direction: an
# address, a bearer token, and a certificate fingerprint that is the identity.
# They are handed to a one-off container from the agent-relay image and to
# nothing else.
# ---------------------------------------------------------------------------

# Does this machine host a runner? That is what decides whether the agent may
# run here, and it is deliberately about what is RUNNING, not about what is
# configured: a stopped runner stack is not a runner, and a machine that has
# merely joined one is a workstation.
runner_hosted_here() {
    [ "$(docker inspect -f '{{.State.Running}}' claudebox-runner 2>/dev/null || true)" = "true" ]
}

agent_usage() {
    cat >&2 <<'USAGE'
usage: claudebox agent <start|enrol|status>      on a workstation
       claudebox agent <add|show|test|forget>    on a runner machine

  On the workstation -- the machine that runs the agent:
    start   Turn the door on and open it: set BOX_AGENT_SERVE=1, bring the box
            and the front door up, report, and open an enrolment window. The
            one command to run on a machine that has never served one.
    enrol   Open an enrolment window and print the line to type on the runner
            machine. For a door that is already up.
    status  Whether the front door is up, and its certificate fingerprint.

  On a runner machine -- the machine that must not run one:
    add <host:port> <code>
            Join that workstation, using the eight-character code its
            "claudebox agent enrol" printed.
    add <host:port> <token> <fingerprint>
            The explicit form, for anyone who would rather not trust a
            certificate on sight.
    show    What is joined (the token is not printed).
    test    Ask it, through the pin, whether it answers.
    forget  Un-join. Headless runs then refuse here rather than being sent.

A runner machine hosts the box minus the agent, on a network with no egress
allowlist. This is what keeps an agent off it while still letting a one-off
prompt typed there be answered -- on the other machine.
USAGE
}

# Build the front door image if it is not here yet.
#
# Directly rather than through compose: the service sits behind the "agent"
# profile, which is off on a runner machine (that is a workstation setting), and
# a build is not the place to be arguing with profile selection.
agent_image() {
    if docker image inspect claudebox-agent-relay:latest >/dev/null 2>&1; then
        return 0
    fi
    echo "claudebox: building the agent client image, which is what talks to the workstation..." >&2
    docker build -q -t claudebox-agent-relay:latest "${BOX_DIR}/agent-relay" >/dev/null || {
        echo "claudebox: could not build claudebox-agent-relay" >&2
        return 1
    }
}

# Feed a request to send.mjs in a one-off container.
#
# The fields go in on STDIN, NUL-separated, and never on the command line: the
# token is in there, and so is the prompt. "docker run -e TOKEN=..." would put
# the token in this machine's process table for anyone to read.
#
# --network default rather than the box's: this container needs the LAN, which
# is the one thing the box never gets.
agent_send() {
    agent_image || return 1
    printf '%s\0' "$@" \
        | docker run --rm -i claudebox-agent-relay:latest node /app/send.mjs
}

# Turn the door on and open it, in one command.
#
# The three steps this replaces are the setting, a start, and an enrolment
# window, and they have to happen in that order: the front door sits behind a
# compose profile the launcher only enables when the setting is there, so
# enrolling before starting finds no container to enrol against.
agent_start() {
    if runner_hosted_here; then
        {
            echo "claudebox: this machine hosts a runner, and the door is what a WORKSTATION"
            echo "claudebox: serves -- turning it on here would put an agent on the one machine"
            echo "claudebox: built not to run one. Run this on the machine that should run"
            echo "claudebox: claude, then join it from here:"
            echo "claudebox:   claudebox agent add <host:port> <code>"
        } >&2
        return 1
    fi

    if [ -z "${BOX_AGENT_SERVE}" ]; then
        config_set BOX_AGENT_SERVE 1
        echo "claudebox: agent door turned on (BOX_AGENT_SERVE=1 in ${BOX_CONFIG})" >&2
    fi
    # This process resolved its settings before that write, and everything below
    # reads them. Exporting also hands the value to the child below, where the
    # environment wins over the file -- so it takes effect even on the run that
    # turned it on.
    export BOX_AGENT_SERVE=1

    # Through the launcher rather than compose_up here: starting the box is also
    # the workspace checks, the dind AppArmor preflight, the allowlist resync and
    # the DDEV hostname rewrite, and a box brought up around those is a box that
    # is only almost right. The child re-reads the config, so it is the one that
    # adds --profile agent and creates the front door. Same reasoning as
    # box_start in plugin-api.sh.
    echo "claudebox: starting the box and the front door..." >&2
    "${BOX_DIR}/claudebox" shell -c true >/dev/null || return 1

    agent_status || return 1

    # The front door's entrypoint opens a window itself the first time, but it
    # prints the code to the container log, where nobody is looking. Open one
    # here so the code lands in front of the person who asked for it.
    #
    # Not when this machine is already joined, for the reason the entrypoint has
    # the same rule: a window is exposure, a machine that starts every morning
    # should not open one every morning, and "claudebox agent enrol" is how you
    # open one deliberately.
    if docker exec claudebox-agent-relay test -f /var/lib/claudebox-agent/enrolled 2>/dev/null; then
        {
            echo
            echo "claudebox: already joined -- no enrolment window opened."
            echo "claudebox: 'claudebox agent enrol' opens one, to join another machine."
        } >&2
        return 0
    fi
    echo >&2
    agent_enrol
}

agent_enrol() {
    if [ -z "${BOX_AGENT_SERVE}" ]; then
        echo "claudebox: the agent door is off here. Put BOX_AGENT_SERVE=1 in ${BOX_CONFIG}," >&2
        echo "claudebox: start the box, then run this again." >&2
        return 1
    fi
    if ! docker exec claudebox-agent-relay true 2>/dev/null; then
        echo "claudebox: the front door is not running; start the box first (claudebox)" >&2
        return 1
    fi
    # The window is opened by the same script the front door's entrypoint uses
    # on a machine that has never been joined, so there is one definition of
    # what a window is.
    docker exec claudebox-agent-relay claudebox-agent-enrol
}

agent_status() {
    local fp
    if [ -z "${BOX_AGENT_SERVE}" ]; then
        echo "claudebox: the agent door is off here (set BOX_AGENT_SERVE=1 to serve one)" >&2
        return 0
    fi
    if ! docker exec claudebox-agent-relay true 2>/dev/null; then
        echo "claudebox: the front door is not running; start the box (claudebox)" >&2
        return 1
    fi
    fp="$(docker exec claudebox-agent-relay cat /var/lib/claudebox-agent/fingerprint 2>/dev/null | tr -d '\r\n')"
    printf 'front door:  up, published on :%s\n' "${BOX_AGENT_PORT}"
    printf 'fingerprint: %s\n' "${fp:-(unknown)}"
    if docker exec claudebox-agent-relay test -f /var/lib/claudebox-agent/enrolled 2>/dev/null; then
        printf 'joined by:   %s\n' \
            "$(docker exec claudebox-agent-relay cat /var/lib/claudebox-agent/enrolled 2>/dev/null | tr -d '\r\n')"
    else
        printf 'joined by:   nobody yet -- "claudebox agent enrol" opens a window\n'
    fi
}

# Trade an enrolment code for the workstation's token, and pin the certificate
# that answered. The mirror of runner_enrol, run the same way and for the same
# reason: that image has node and a route off this machine.
agent_join() {
    local addr="${1}" code="${2}" out token fp
    agent_image || return 1
    out="$(docker run --rm claudebox-agent-relay:latest \
              node /app/enrol.mjs "${addr}" "${code}")" || return 1
    token="$(printf '%s\n' "${out}" | sed -n 's/^TOKEN=//p')"
    fp="$(printf '%s\n' "${out}" | sed -n 's/^FINGERPRINT=//p')"
    if [ -z "${token}" ] || [ -z "${fp}" ]; then
        echo "claudebox: the workstation did not return a usable token" >&2
        return 1
    fi
    config_set BOX_AGENT "${addr}"
    config_set BOX_AGENT_TOKEN "${token}"
    config_set BOX_AGENT_FINGERPRINT "${fp}"
    echo "claudebox: joined the agent at ${addr}" >&2
    echo "claudebox: pinned certificate ${fp}" >&2
    echo "claudebox: headless one-off runs from this machine now go there" >&2
}

agent_cmd() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        start)        agent_start ;;
        enrol|enroll) agent_enrol ;;
        status)       agent_status ;;
        add)
            case "$#" in
                2) agent_join "${1}" "${2}" ;;
                3)
                    config_set BOX_AGENT "${1}"
                    config_set BOX_AGENT_TOKEN "${2}"
                    config_set BOX_AGENT_FINGERPRINT "${3}"
                    echo "claudebox: joined the agent at ${1}" >&2
                    ;;
                *) agent_usage; return 2 ;;
            esac
            ;;
        show)
            if [ -z "${BOX_AGENT}" ]; then
                echo "claudebox: no agent joined -- run 'claudebox agent add <host:port> <code>'" >&2
                return 0
            fi
            printf 'agent:       %s\n' "${BOX_AGENT}"
            printf 'fingerprint: %s\n' "${BOX_AGENT_FINGERPRINT:-(unset)}"
            printf 'token:       %s\n' "$([ -n "${BOX_AGENT_TOKEN}" ] && echo '(set)' || echo '(unset)')"
            ;;
        test)
            if [ -z "${BOX_AGENT}" ] || [ -z "${BOX_AGENT_TOKEN}" ]; then
                echo "claudebox: no agent joined -- run 'claudebox agent add <host:port> <code>'" >&2
                return 1
            fi
            agent_send health "${BOX_AGENT}" "${BOX_AGENT_TOKEN}" "${BOX_AGENT_FINGERPRINT}"
            ;;
        forget)
            config_set BOX_AGENT ""
            config_set BOX_AGENT_TOKEN ""
            config_set BOX_AGENT_FINGERPRINT ""
            echo "claudebox: forgotten. Headless runs here will now refuse rather than being sent." >&2
            ;;
        -h|--help|help|"") agent_usage ;;
        *) echo "claudebox: unknown agent subcommand '${sub}'" >&2; agent_usage; return 2 ;;
    esac
}

# ---------------------------------------------------------------------------
# Plugins
#
# A plugin is a directory on BOX_PLUGIN_PATH holding executables:
#
#   plugins/my-plugin/commands/thing      ->  claudebox my-plugin:thing [args]
#
# The colon is what makes this safe to bolt onto a launcher whose real job is
# forwarding arguments to claude. No built-in subcommand contains one, so a
# plugin can never shadow one; and an argument that merely looks like a plugin
# reference -- a prompt beginning "TODO: ..." -- is only intercepted if a plugin
# by that name is actually installed. Anything else falls through to claude
# unchanged, which is the behaviour every unrecognised argument already has.
#
# Commands are ordinary executables in any language, run ON THE HOST with the
# launcher's environment exported (BOX_*, CLAUDEBOX_*). A shell one can source
# "${CLAUDEBOX_PLUGIN_API}" for box_exec and friends and reach into the box in
# one line; anything else gets the same information from the variables.
#
# Nothing is installed, registered or generated: the directory being on the path
# is the whole of it. plugins/ in this repository is where the ones claudebox
# ships live, so adding a command means adding a directory of scripts and
# nothing else -- no dispatch arm here, no entry in a list, nothing to keep in
# step. BOX_PLUGIN_PATH is how a plugin from somewhere else joins them.
#
# What this buys, over adding another arm to the case below: a plugin cannot
# shadow a built-in or take a name away from claude (see the colon, above), it
# is self-contained enough to move between checkouts, and it reaches the box
# through box_exec in plugin-api.sh rather than through a second copy of the
# exec flags.
# ---------------------------------------------------------------------------

# A plugin or command name. Restrictive on purpose: this becomes a path
# component, and "../" reaching out of the plugin directory would make
# "claudebox ..:/etc/whatever" a way to run an arbitrary executable.
plugin_name_ok() {
    [[ "${1}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]
}

# Every configured entry, in order, deduplicated -- whether or not it exists.
# Deduplicated because the usual way to add a directory to BOX_PLUGIN_PATH is to
# write it out with the default appended, and naming the same directory twice
# should not report every plugin in it twice.
#
# read -ra rather than an unquoted expansion so a path containing a glob
# character is not expanded against the filesystem.
plugin_path_entries() {
    local -a dirs=()
    local dir seen=$'\n'
    IFS=: read -ra dirs <<< "${BOX_PLUGIN_PATH}"
    for dir in "${dirs[@]}"; do
        [ -n "${dir}" ] || continue
        dir="${dir%/}"
        case "${seen}" in *$'\n'"${dir}"$'\n'*) continue ;; esac
        seen="${seen}${dir}"$'\n'
        printf '%s\n' "${dir}"
    done
}

# The same, narrowed to the ones that are actually there. A missing entry is
# normal -- neither default has to exist -- so it is skipped silently here and
# only mentioned by "claudebox plugins", where "put one here" is the answer.
plugin_dirs() {
    local dir
    while IFS= read -r dir; do
        [ -d "${dir}" ] && printf '%s\n' "${dir}"
    done < <(plugin_path_entries)
}

# Where a named plugin lives, first match on the path wins. A directory without
# commands/ is not a plugin -- that is what keeps a stray README or a checkout
# of something else from being reported as one.
plugin_find() {
    local name="${1}" dir
    plugin_name_ok "${name}" || return 1
    while IFS= read -r dir; do
        if [ -d "${dir}/${name}/commands" ]; then
            printf '%s\n' "${dir}/${name}"
            return 0
        fi
    done < <(plugin_dirs)
    return 1
}

plugin_commands() {
    local dir="${1}" f
    for f in "${dir}"/commands/*; do
        [ -f "${f}" ] || continue
        printf '%s\n' "${f##*/}"
    done
}

# A command's one-line summary, taken from a "# description: ..." comment in its
# first few lines. A convention rather than a manifest: a plugin should be a
# directory of scripts and nothing else, and a script can describe itself.
plugin_describe() {
    sed -n '1,20{s/^#[[:space:]]*description:[[:space:]]*//p;}' "${1}" 2>/dev/null | head -1
}

plugins_list() {
    local dir name path cmd desc found="" seen=" "
    while IFS= read -r dir; do
        for path in "${dir}"/*/; do
            [ -d "${path}commands" ] || continue
            name="$(basename -- "${path}")"
            plugin_name_ok "${name}" || continue
            # Earlier entries on the path shadow later ones, so a name already
            # printed is not printed again from further along.
            case "${seen}" in *" ${name} "*) continue ;; esac
            seen="${seen}${name} "
            found=1
            printf '%s  (%s)\n' "${name}" "${path%/}"
            while IFS= read -r cmd; do
                desc="$(plugin_describe "${path}commands/${cmd}")"
                if [ -x "${path}commands/${cmd}" ]; then
                    printf '  claudebox %s:%-20s %s\n' "${name}" "${cmd}" "${desc}"
                else
                    printf '  claudebox %s:%-20s %s\n' "${name}" "${cmd}" \
                        "(not executable -- chmod +x)"
                fi
            done < <(plugin_commands "${path%/}")
        done
    done < <(plugin_dirs)

    if [ -z "${found}" ]; then
        echo "claudebox: no plugins installed" >&2
    fi
    {
        echo
        echo "searched (earliest wins, set BOX_PLUGIN_PATH to change):"
        while IFS= read -r dir; do
            if [ -d "${dir}" ]; then
                printf '  %s\n' "${dir}"
            else
                printf '  %s  (does not exist)\n' "${dir}"
            fi
        done < <(plugin_path_entries)
        echo
        echo "a plugin is a directory of executables:"
        echo "  <dir>/my-plugin/commands/thing   ->  claudebox my-plugin:thing [args]"
        echo "see ${BOX_DIR}/plugins/example for a worked one, and CLAUDEBOX.md for"
        echo "the environment and helpers a command is handed."
    } >&2
}

# Run "<plugin>:<command>", or return so the caller falls through to claude.
#
# Three outcomes, and the difference between the last two is the whole design:
# an unknown PLUGIN is not this launcher's business (it is an argument for
# claude), while a known plugin with an unknown COMMAND is a typo, and saying so
# -- with the list -- beats sending it to an agent as a prompt.
plugin_dispatch() {
    local spec="${1}" name cmd dir exe
    [[ "${spec}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*:[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || return 0
    name="${spec%%:*}"
    cmd="${spec#*:}"
    dir="$(plugin_find "${name}")" || return 0
    shift

    exe="${dir}/commands/${cmd}"
    if [ ! -f "${exe}" ]; then
        echo "claudebox: plugin '${name}' has no command '${cmd}'. It has:" >&2
        plugin_commands "${dir}" | sed "s/^/  claudebox ${name}:/" >&2
        exit 2
    fi
    if [ ! -x "${exe}" ]; then
        echo "claudebox: ${exe} is not executable -- chmod +x it" >&2
        exit 126
    fi

    # What a command is handed, beyond the exported BOX_*/CLAUDEBOX_* settings.
    # CLAUDEBOX_PLUGIN_STATE is a path, not a directory: it is created only if
    # the command asks for it, via plugin_state in the API. It sits outside
    # plugins/ -- that directory is tracked, and generated state does not belong
    # in it -- and outside the plugin's own directory, which may be read-only or
    # someone else's checkout.
    export CLAUDEBOX_PLUGIN="${name}"
    export CLAUDEBOX_PLUGIN_COMMAND="${cmd}"
    export CLAUDEBOX_PLUGIN_DIR="${dir}"
    export CLAUDEBOX_PLUGIN_STATE="${BOX_DIR}/plugin-state/${name}"
    # exec, so the command owns the terminal and its exit status is the
    # launcher's -- a plugin should be indistinguishable from a built-in.
    exec "${exe}" "$@"
}

# ---------------------------------------------------------------------------
# The gate: what may happen on a machine that hosts a runner
#
# A runner machine is the box MINUS the agent, on an ordinary bridge with no
# proxy and no allowlist -- it has to reach package registries to build what it
# tests. It is the wrong machine to run an agent on, container or not, and until
# now nothing stopped someone typing "claudebox" there.
#
# So nothing here starts the box. A headless one-off is sent to the workstation
# that was joined and answered there; everything else refuses and says where to
# go. Two exceptions, both necessary rather than convenient: "agent" is how this
# machine is pointed at a workstation in the first place, and "help" should
# never be the thing that fails.
#
# Placed before the command dispatch, so it covers every subcommand, every
# plugin and the pass-through to claude alike.
# ---------------------------------------------------------------------------
runner_machine_gate() {
    local arg headless="" first="${1:-}"

    case "${first}" in
        agent|help|-h|--help) return 0 ;;
    esac

    # Headless means claude with a prompt and no terminal to answer on: -p or
    # --print. It is only a claude run at all if the first argument is not one
    # of this launcher's own subcommands -- "claudebox opencode ... -p" is a
    # different agent, and "claudebox media ..." is not an agent at all.
    case "${first}" in
        shell|opencode|media|runner|stop|rebuild|allowed|denied|allow|reload|eject|strip|fix-perms|plugins)
            ;;
        *)
            for arg in "$@"; do
                case "${arg}" in
                    -p|--print) headless=1; break ;;
                esac
            done
            ;;
    esac

    if [ -z "${headless}" ]; then
        {
            echo "claudebox: this machine hosts a runner, so it is not where the agent runs."
            echo "claudebox: a runner is the box minus the agent, on a network with no egress"
            echo "claudebox: allowlist -- running claude here would put an agent on the one"
            echo "claudebox: machine built not to have one."
            echo "claudebox:"
            echo "claudebox:   claudebox-runner <cmd>     this machine's own commands"
            echo "claudebox:   claudebox <cmd>            on the workstation, for everything else"
            echo "claudebox:"
            echo "claudebox: a headless one-off (claudebox -p '...') is the exception: it is sent"
            echo "claudebox: to the workstation joined with 'claudebox agent add'."
        } >&2
        exit 1
    fi

    if [ -z "${BOX_AGENT}" ] || [ -z "${BOX_AGENT_TOKEN}" ] || [ -z "${BOX_AGENT_FINGERPRINT}" ]; then
        {
            echo "claudebox: this machine hosts a runner, so a headless run is sent to the"
            echo "claudebox: workstation rather than answered here -- but no workstation is joined."
            echo "claudebox:"
            echo "claudebox:   on the workstation:   claudebox agent enrol"
            echo "claudebox:   then here:            claudebox agent add <host:port> <code>"
        } >&2
        exit 1
    fi

    # Which project, on the other machine. --project names it outright;
    # otherwise it is the directory below the workspace root that the current
    # directory sits in, which is the same tree layout both machines use.
    #
    # This is OURS, not claude's: it is consumed here and never forwarded.
    local project="" rest=() skip=""
    for arg in "$@"; do
        if [ -n "${skip}" ]; then project="${arg}"; skip=""; continue; fi
        case "${arg}" in
            --project) skip=1 ;;
            --project=*) project="${arg#--project=}" ;;
            *) rest+=("${arg}") ;;
        esac
    done

    # BOX_WORKSPACE_HOST, not BOX_WORKSPACE: this resolves a directory on THIS
    # machine's disk. The two are the same by default and differ when the tree
    # is bound in from somewhere else, and it is the host-side path the cwd is
    # actually under.
    if [ -z "${project}" ]; then
        case "${PWD}" in
            "${BOX_WORKSPACE_HOST}"/*)
                project="${PWD#"${BOX_WORKSPACE_HOST}"/}"
                project="${project%%/*}"
                ;;
        esac
    fi
    if [ -z "${project}" ]; then
        {
            echo "claudebox: cannot tell which project this run is about, so the workstation"
            echo "claudebox: would not know where to run it. Either run this from inside a project"
            echo "claudebox: under ${BOX_WORKSPACE_HOST}, or name one:"
            echo "claudebox:   claudebox --project <name> -p '...'"
        } >&2
        exit 2
    fi
    case "${project}" in
        */*|.|..|-*)
            echo "claudebox: '${project}' is not a project name (one directory under the workspace)" >&2
            exit 2 ;;
    esac

    echo "claudebox: sending this run to ${BOX_AGENT} (project ${project}); nothing runs here" >&2
    agent_send run "${BOX_AGENT}" "${BOX_AGENT_TOKEN}" "${BOX_AGENT_FINGERPRINT}" \
        "${project}" "${rest[@]}"
    exit $?
}

if runner_hosted_here; then
    runner_machine_gate "$@"
fi

case "${1:-}" in
    help|-h|--help)
        cat >&2 <<'USAGE'
claudebox -- run a coding agent in an isolated container over ~/Projects

  claudebox                  interactive session in the current directory
  claudebox <args...>        args are passed straight through to claude
  claudebox opencode [args]  run opencode instead, args passed through to it
  claudebox shell [args]     bash in the box instead

  claudebox allow <domain>   permit a domain and reload the egress proxy
                             wildcards work, but quote them:
                               claudebox allow '*.example.com'
  claudebox reload           re-apply allowlist.conf after editing it by hand
  claudebox allowed          show the egress allowlist
  claudebox denied           show requests the proxy has blocked

  claudebox media add <path> copy material off a drive into the box's /media
                             (the drive itself is not mounted -- eject freely)
  claudebox media ls         list what is staged there
  claudebox media rm <name>  delete a staged entry

  claudebox eject            release a removable workspace: stop everything
                             holding it, unmount, then close the encrypted
                             volume -- which is what proves it is released. A
                             bare "udisksctl unmount" can report success while a
                             container still holds the drive. --power-off also
                             powers the disk down.

  claudebox strip [args]     delete gitignored build output (node_modules,
                             vendor, target...) from the workspace -- for a
                             workspace on a drive, which should carry source and
                             not artifacts. Lists and asks first; --dry-run to
                             only look. Same script the box's agent can run as
                             claudebox-strip-artifacts.

  claudebox fix-perms        give the workspace back to you after a container
                             process wrote into it as root (native engine only:
                             Docker Desktop squashed every uid to yours)

  claudebox runner add <host:port> <code>
                             join a test runner on another machine, using the
                             eight-character code its "claudebox-runner" prints.
                             Then "runner run <cmd>" in the box runs it there.
                             A <token> <fingerprint> pair also works, from
                             "claudebox-runner join --full".
  claudebox runner show|test|forget

  claudebox agent start      let a machine that HOSTS a runner send its headless
                             one-off runs here to be answered, instead of running
                             an agent on itself. Turns the door on, brings it up
                             and prints the line to type over there.
  claudebox agent enrol      open another enrolment window, for one more machine
  claudebox agent status     whether that front door is up, and its fingerprint
  claudebox agent add <host:port> <code>
                             the other side of it, run ON a runner machine
  claudebox agent show|test|forget

  claudebox rebuild          rebuild images (after Dockerfile/squid.conf edits)
  claudebox stop             stop the stack (volumes survive)

  claudebox plugins          list the commands plugins add, and where they are
                             looked for. A plugin is a directory of executables
                             in plugins/, run as "claudebox <plugin>:<command>
                             [args]"; adding one means adding the directory and
                             nothing else. See plugins/example, and set
                             BOX_PLUGIN_PATH to look somewhere as well.

Env overrides: BOX_USER, BOX_HOST_HOME, BOX_MKCERT_CA
               BOX_WORKSPACE       where the box sees the tree  (default ~/Projects)
               BOX_WORKSPACE_HOST  the host directory bound there (default: the same,
                                   which is what keeps printed paths clickable). Point
                                   it elsewhere -- an external drive, say -- to work on
                                   a tree that does not live under ~. The path must be
                                   on Docker Desktop's file-sharing list, and sharing a
                                   removable drive pins it until Desktop is quit; for
                                   read-only material use "claudebox media add" instead.
               BOX_DDEV_PROJECT  which project's database is reachable as db:3306
For Claude Code's own help:  claudebox shell -c 'claude --help'
For opencode's own help:     claudebox opencode --help
USAGE
        exit 0
        ;;

    media)
        shift
        case "${1:-ls}" in
            ls|list) media_list ;;
            add)     shift; media_add "$@" ;;
            rm)      shift; media_rm "$@" ;;
            *)       media_usage; exit 2 ;;
        esac
        exit 0
        ;;

    runner)
        shift
        runner_cmd "$@"
        exit $?
        ;;

    stop)     exec "${COMPOSE[@]}" down ;;
    rebuild)  require_workspace
              "${COMPOSE[@]}" build --no-cache
              compose_up --force-recreate
              exit 0 ;;

    allowed)  exec grep -vE '^\s*(#|$)' "${ALLOWLIST}" ;;

    eject)
        # Release a removable workspace, in the one order that actually works.
        #
        # The trap this exists for, measured on this host: with the box running,
        # "udisksctl unmount" SUCCEEDS and the mountpoint disappears -- while the
        # container's mount namespace still holds the filesystem. It goes on
        # reading the tree, the device stays busy, and nothing in that success
        # message says the drive is unsafe to pull. So: stop everything holding
        # it first, then unmount, then prove the release by locking (LUKS) --
        # and only claim it is safe when a step actually confirmed it.
        shift
        eject_power_off=""
        case "${1:-}" in
            --power-off) eject_power_off=1 ;;
            "") ;;
            *) echo "usage: claudebox eject [--power-off]" >&2; exit 2 ;;
        esac

        if ! command -v findmnt >/dev/null 2>&1 || ! command -v udisksctl >/dev/null 2>&1; then
            echo "claudebox: eject needs findmnt and udisksctl (util-linux, udisks2)" >&2
            exit 1
        fi
        if [ ! -d "${BOX_WORKSPACE_HOST}" ]; then
            # The device is identified from the workspace path, so a workspace
            # that is already gone leaves nothing to work from. Worth saying what
            # to do anyway: "unmounted but still unlocked" is a real state to be
            # in -- it is where a half-finished eject stops -- and it is the one
            # that looks finished without being finished.
            echo "claudebox: ${BOX_WORKSPACE_HOST} is not there; nothing to eject" >&2
            echo "claudebox: (if a drive is unmounted but its encrypted volume is still open," >&2
            echo "claudebox: close it with 'udisksctl lock -b /dev/<partition>' before unplugging)" >&2
            exit 1
        fi

        eject_src="$(findmnt -no SOURCE --target "${BOX_WORKSPACE_HOST}" 2>/dev/null || true)"
        eject_mnt="$(findmnt -no TARGET --target "${BOX_WORKSPACE_HOST}" 2>/dev/null || true)"
        if [ -z "${eject_mnt}" ]; then
            echo "claudebox: cannot tell what ${BOX_WORKSPACE_HOST} is mounted from" >&2
            exit 1
        fi
        # A workspace on the root filesystem has nothing to eject, and unmounting
        # what it is really asking about would be a very bad day.
        if [ "${eject_mnt}" = "/" ]; then
            echo "claudebox: ${BOX_WORKSPACE_HOST} is on the root filesystem, not a removable" >&2
            echo "claudebox: mount -- nothing to eject." >&2
            exit 1
        fi
        echo "claudebox: workspace is ${eject_src} at ${eject_mnt}" >&2

        # DDEV projects living on the drive pin it exactly as the box does, and
        # they are not part of this compose stack. Stop the ones that are on it;
        # projects elsewhere are left alone.
        if command -v ddev >/dev/null 2>&1; then
            ddev_on_drive="$(ddev list -j 2>/dev/null \
                | jq -r --arg m "${eject_mnt}/" \
                    '.raw[]? | select((.status // "") == "running")
                     | select((.approot + "/") | startswith($m)) | .name' 2>/dev/null || true)"
            if [ -n "${ddev_on_drive}" ]; then
                echo "claudebox: stopping DDEV projects on this drive: $(printf '%s' "${ddev_on_drive}" | tr '\n' ' ')" >&2
                # shellcheck disable=SC2086
                ddev stop ${ddev_on_drive} >/dev/null 2>&1 || \
                    echo "claudebox: could not stop them; the unmount below will say so" >&2
            fi
        fi

        echo "claudebox: stopping the box" >&2
        "${COMPOSE[@]}" down >/dev/null 2>&1 || true

        if findmnt -no TARGET "${eject_mnt}" >/dev/null 2>&1; then
            if ! udisksctl unmount -b "${eject_src}" >&2; then
                echo "claudebox: could not unmount ${eject_src}; something still has it open." >&2
                echo "claudebox: 'lsof ${eject_mnt}' (or fuser -vm) will name it." >&2
                exit 1
            fi
        else
            echo "claudebox: already unmounted" >&2
        fi

        # Locking is the proof. It fails with "Device or resource busy" while
        # anything still holds the filesystem -- including a container namespace
        # that survived the unmount -- so a success here is the real answer and
        # an unmount on its own is not.
        #
        # PKNAME is read with -s (the inverse tree). Without it lsblk reports an
        # EMPTY parent for a device-mapper node -- PKNAME is only filled in
        # walking downwards -- and the first version of this code took that
        # empty string as "not encrypted", skipped the lock, and reported the
        # drive safe to unplug while the LUKS volume was still open. Anything
        # here that cannot prove a release now says so instead.
        eject_type="$(lsblk -no TYPE "${eject_src}" 2>/dev/null | head -1 || true)"
        eject_parent="$(lsblk -sno PKNAME "${eject_src}" 2>/dev/null | head -1 || true)"

        if [ "${eject_type}" = "crypt" ]; then
            if [ -z "${eject_parent}" ]; then
                echo "claudebox: ${eject_src} is an encrypted volume but its backing device could" >&2
                echo "claudebox: not be identified, so it cannot be closed here. It is unmounted;" >&2
                echo "claudebox: close it in your file manager before unplugging." >&2
                exit 1
            fi
            if ! udisksctl lock -b "/dev/${eject_parent}" >&2; then
                echo "claudebox: unmounted, but the encrypted volume will not close -- something" >&2
                echo "claudebox: still holds it. Do NOT unplug yet." >&2
                exit 1
            fi
            eject_disk="$(lsblk -sno PKNAME "/dev/${eject_parent}" 2>/dev/null | head -1 || true)"
            eject_proved=1
        else
            eject_disk="${eject_parent}"
            eject_proved=""
        fi

        if [ -n "${eject_power_off}" ] && [ -n "${eject_disk}" ]; then
            if udisksctl power-off -b "/dev/${eject_disk}" >&2; then
                eject_proved=1
            else
                echo "claudebox: could not power the disk down" >&2
            fi
        fi

        if [ -n "${eject_proved}" ]; then
            echo "claudebox: ${eject_mnt} released -- safe to unplug" >&2
        else
            # Plain filesystem, no power-off asked for: the unmount returned
            # success, and on this stack that alone has been seen to mean
            # nothing. Say what is and is not known rather than inventing
            # confidence.
            echo "claudebox: ${eject_mnt} unmounted. That is not proof the kernel released the" >&2
            echo "claudebox: device -- rerun with --power-off, which fails if anything still" >&2
            echo "claudebox: holds it, to be sure before unplugging." >&2
        fi
        exit 0
        ;;

    strip)
        # Delete gitignored build output from the workspace. The work is
        # claudebox-strip-artifacts in the box -- the same script the box's agent
        # runs -- because the tree is mounted read-write in there as the box
        # user, so nothing here needs to touch the host filesystem itself.
        #
        # -t when this is a terminal: the script asks before deleting, and a
        # confirmation prompt that cannot be answered is just a refusal.
        shift
        if ! docker exec "${CONTAINER}" true 2>/dev/null; then
            echo "claudebox: the box is not running; start it first" >&2
            exit 1
        fi
        strip_flags=(-i -u "${BOX_UID}:${BOX_GID}" -w "${BOX_WORKSPACE}")
        if [ -t 0 ] && [ -t 1 ]; then
            strip_flags+=(-t)
        fi
        exec docker exec "${strip_flags[@]}" "${CONTAINER}" \
            claudebox-strip-artifacts "$@"
        ;;

    fix-perms)
        # Give the workspace back to you after a container process wrote into it
        # as root.
        #
        # Docker Desktop made this impossible: its virtiofsd squashed every uid
        # to 1000 in both directions, so a root write in a container came back
        # owned by you. A native engine passes ownership straight through, and
        # anything a root process in a container creates in the tree is owned by
        # root on the host -- which the box, running as ${BOX_UID}, then cannot
        # touch. (That squashing is also why CLAUDEBOX.md says never to widen
        # entrypoint.sh's sweep to the workspace: ownership there used to be an
        # artifact. It is real now, and this is the sweep for it.)
        #
        # Run as root INSIDE the box rather than with sudo out here: chown needs
        # root, the box has it on the same bind, and the host user does not need
        # to hand this script any privilege at all.
        if ! docker exec "${CONTAINER}" true 2>/dev/null; then
            echo "claudebox: the box is not running; start it first" >&2
            exit 1
        fi

        # Resolve the target ids from BOX_USER's passwd entry, NOT from
        # BOX_UID/BOX_GID.
        #
        # Those default to "$(id -u)"/"$(id -g)", which are the ids of the
        # INVOKING PROCESS -- and a process running under "sg docker" or
        # "newgrp" has the group it switched to as its primary, not the user's
        # own. This command recursively chowns a whole source tree, so taking
        # that as the target rewrites every file in the workspace to the wrong
        # group. That is not hypothetical: it happened here, to 230k files,
        # while this very command was being tested through "sg docker -c".
        # Everywhere else BOX_GID is only ever handed to "docker exec -u", where
        # a wrong value affects one process and nothing on disk.
        fix_uid="$(id -u "${BOX_USER}" 2>/dev/null || true)"
        fix_gid="$(id -g "${BOX_USER}" 2>/dev/null || true)"
        if [ -z "${fix_uid}" ] || [ -z "${fix_gid}" ]; then
            echo "claudebox: cannot resolve ${BOX_USER}'s uid/gid on this host" >&2
            exit 1
        fi

        echo "claudebox: scanning ${BOX_WORKSPACE_HOST} for files not owned by ${fix_uid}:${fix_gid}..." >&2
        # Count before changing anything. A recursive chown is not something to
        # discover the scope of afterwards, and a number in the thousands means
        # the target ids are wrong far more often than it means the workspace is
        # genuinely that broken.
        mismatched="$(docker exec -u 0 "${CONTAINER}" \
            find "${BOX_WORKSPACE}" \
                \( ! -uid "${fix_uid}" -o ! -gid "${fix_gid}" \) \
                -print 2>/dev/null | wc -l)"
        if [ "${mismatched}" -eq 0 ]; then
            echo "claudebox: nothing to fix" >&2
            exit 0
        fi
        if [ "${mismatched}" -gt 1000 ]; then
            echo "claudebox: ${mismatched} files do not match. That is a lot -- check that" >&2
            echo "claudebox: ${fix_uid}:${fix_gid} is really who should own ${BOX_WORKSPACE_HOST}" >&2
            echo "claudebox: before continuing." >&2
            if [ ! -t 0 ]; then
                echo "claudebox: refusing to chown that many files non-interactively." >&2
                exit 1
            fi
            printf 'claudebox: chown %s files to %s:%s? [y/N] ' \
                "${mismatched}" "${fix_uid}" "${fix_gid}" >&2
            read -r reply
            case "${reply}" in
                y|Y|yes|YES) ;;
                *) echo "claudebox: nothing changed" >&2; exit 1 ;;
            esac
        fi

        # -h so a symlink is retargeted rather than its destination, which may
        # sit outside the tree.
        reclaimed="$(docker exec -u 0 "${CONTAINER}" \
            find "${BOX_WORKSPACE}" \
                \( ! -uid "${fix_uid}" -o ! -gid "${fix_gid}" \) \
                -exec chown -h "${fix_uid}:${fix_gid}" {} + -print 2>/dev/null \
            | wc -l)"
        echo "claudebox: reclaimed ${reclaimed} file(s)" >&2
        exit 0
        ;;

    denied)
        # TCP_DENIED is what Squid logs for a request the allowlist refused.
        # -a because the log picks up stray bytes from tunnelled traffic and
        # grep then reports "binary file matches" instead of the lines.
        denied_lines="$(docker exec "${PROXY}" \
            grep -a TCP_DENIED /var/log/squid/access.log 2>/dev/null \
            | awk '{print $4, $5}' | sort -u || true)"
        if [ -z "${denied_lines}" ]; then
            echo "claudebox: nothing blocked yet" >&2
            exit 0
        fi
        printf '%s\n' "${denied_lines}"
        # Two different failures land in this list and the difference matters.
        # "CONNECT host:443" is the allowlist doing its job. "GET https://..."
        # is not an allowlist decision at all -- it is a client that cannot
        # tunnel -- and adding the domain will not help.
        if printf '%s\n' "${denied_lines}" | grep -qE '^[A-Z]+ https://'; then
            {
                echo
                echo "claudebox: lines above reading '<METHOD> https://...' are NOT allowlist"
                echo "claudebox: refusals. That client cannot tunnel through a proxy, so it sent"
                echo "claudebox: the URL in a plain request; allowing the domain changes nothing."
                echo "claudebox: busybox wget does this, which covers most alpine images -- use"
                echo "claudebox: curl instead, or 'apk add wget' for one that can CONNECT."
                echo "claudebox: A genuinely blocked host looks like 'CONNECT host:443'."
            } >&2
        fi
        exit 0
        ;;

    allow)
        domain="${2:-}"
        if [ -z "${domain}" ]; then
            echo "usage: claudebox allow <domain>    (quote wildcards: '*.example.com')" >&2
            exit 2
        fi
        # Compare literally, not as a regex: entries may contain "*", which
        # grep -E reads as a repetition operator and rejects outright at the
        # start of a pattern.
        entries="$(sed 's/#.*//' "${ALLOWLIST}" | tr -s '[:space:]' '\n' | grep -v '^$' || true)"
        if printf '%s\n' "${entries}" | grep -qxF -- "${domain}"; then
            echo "claudebox: ${domain} is already allowed" >&2
        else
            printf '%s\n' "${domain}" >> "${ALLOWLIST}"
            echo "claudebox: allowed ${domain}" >&2
        fi
        reload_proxy
        exit $?
        ;;

    reload)
        # For edits made directly to allowlist.conf.
        reload_proxy
        exit $?
        ;;

    agent)
        shift
        agent_cmd "$@"
        exit $?
        ;;

    plugins)
        plugins_list
        exit 0
        ;;

    # User-installed commands: "claudebox my-plugin:thing". Last in the case so
    # it cannot shadow anything above -- and no built-in name contains a colon,
    # so it never could. plugin_dispatch execs when the reference names an
    # installed command and RETURNS otherwise, leaving the argument to fall
    # through to claude, which is what any other unrecognised argument does.
    *:*)
        plugin_dispatch "$@"
        ;;
esac

# ---------------------------------------------------------------------------
# Bring the box up
# ---------------------------------------------------------------------------

require_workspace

# DDEV creates this network when the first project starts. Create it ahead of
# time so the box doesn't depend on a project being up; DDEV reuses it as-is.
docker network inspect ddev_default >/dev/null 2>&1 \
    || docker network create ddev_default >/dev/null

# The override (plans bind + optional gitconfig) is generated up front, near the
# COMPOSE definition, so it is already in place here.
compose_up >/dev/null

# "up -d" returns once the container is started, not once entrypoint.sh has
# finished seeding config -- exec'ing in too early lands in a half-built HOME.
for _ in $(seq 1 120); do
    if docker exec "${CONTAINER}" test -f /run/claudebox.ready 2>/dev/null; then
        break
    fi
    sleep 0.5
done

# The proxy holds a stale copy often enough to be worth checking on every
# launch, not just when the allowlist is edited -- a session that starts against
# an old list fails in a way nothing explains. Do this before the hostnames are
# written below, since remounting restarts the proxy and clears them.
if ! allowlist_in_sync; then
    if resync_allowlist; then
        docker exec "${PROXY}" allowlist reload >/dev/null 2>&1 || true
    fi
fi

write_ddev_hosts

if [ "${BOX_DDEV_PROJECT}" = "none" ]; then
    echo "claudebox: no single DDEV project to bridge; db:3306 is unmapped (set BOX_DDEV_PROJECT)" >&2
else
    echo "claudebox: DDEV database -> ddev-${BOX_DDEV_PROJECT}-db, reachable as db:3306" >&2
fi

apply_ddev_fixups

# ---------------------------------------------------------------------------
# Attach
# ---------------------------------------------------------------------------

# Start in the current directory's counterpart inside the box -- the same path
# when the two workspace roots are equal, its translation otherwise. Anywhere
# outside the workspace has no counterpart, so fall back to the root of the tree.
workdir="${BOX_WORKSPACE}"
if mapped_pwd="$(box_path "${PWD}")"; then
    workdir="${mapped_pwd}"
fi

# The flags a session is attached with -- uid/gid, working directory, a tty when
# there is one, terminal capabilities and the proxy address for nested
# containers. Built by box_exec_flags in plugin-api.sh, because a plugin running
# something in the box needs exactly the same set and two copies would drift.
box_exec_flags "${workdir}"

if [ "${1:-}" = "shell" ]; then
    shift
    exec docker exec "${BOX_EXEC_FLAGS[@]}" "${CONTAINER}" bash "$@"
fi

# The box's other agent. Everything above is the same for both -- same box, same
# allowlist, same DDEV bridging and the same working directory -- so this is
# only a different program to hand the session to. Its own subcommands and flags
# pass straight through: "claudebox opencode run '...'", "claudebox opencode
# auth login".
if [ "${1:-}" = "opencode" ]; then
    shift
    exec docker exec "${BOX_EXEC_FLAGS[@]}" "${CONTAINER}" opencode "$@"
fi

exec docker exec "${BOX_EXEC_FLAGS[@]}" "${CONTAINER}" claude "$@"
