#!/usr/bin/env bash
#
# Start the claudebox test runner on this machine.
#
# The runner is the box's environment minus the agent, plus a network API. It
# exists so that the agent can run on one machine and the tests -- Matomo's UI
# suite above all -- on a more powerful one, without the screenshot baselines
# drifting: this image is built FROM the same base stage as the box's, so the
# fonts, the fontconfig rules and the ImageMagick limits are the same layers and
# not merely the same intentions.
#
#   claudebox-runner            build if needed, start, and print the join line
#   claudebox-runner join       print the join line again
#   claudebox-runner status     show what is running and what it holds
#   claudebox-runner logs [-f]  the runner's log
#   claudebox-runner rebuild    rebuild both images from scratch
#   claudebox-runner stop       stop the stack (the workspace volume survives)
#   claudebox-runner reset      stop and DELETE the synced workspace
#
# Nothing here needs the agent machine. A checkout of this repo and this one
# command is the whole setup, apart from the AppArmor profile the launcher will
# tell you to install if your kernel needs it.
set -euo pipefail

# Resolve symlinks: invoked from ~/.local/bin, BASH_SOURCE is the link.
BOX_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
COMPOSE=(docker compose -f "${BOX_DIR}/docker-compose.runner.yaml")
BASE_IMAGE="${BOX_RUNNER_BASE_IMAGE:-claudebox-base:latest}"
STATE_CONTAINER=claudebox-runner

# ---------------------------------------------------------------------------
# Settings
#
# The same ~/.claudebox/config the box launcher reads, with its own allowlist:
# these are the settings that describe a RUNNER machine, and the box's settings
# (workspace, DDEV project, mkcert) mean nothing here. Environment wins, exactly
# as it does there.
# ---------------------------------------------------------------------------
BOX_CONFIG="${BOX_CONFIG:-${BOX_DIR}/config}"
BOX_SETTINGS=(
    BOX_USER BOX_UID BOX_GID
    BOX_DIND_APPARMOR
    BOX_RUNNER_PORT BOX_RUNNER_WORKSPACE BOX_RUNNER_BASE_IMAGE
)
if [ -f "${BOX_CONFIG}" ]; then
    declare -A _from_env=()
    for _s in "${BOX_SETTINGS[@]}"; do
        if [ -n "${!_s+set}" ]; then _from_env["${_s}"]="${!_s}"; fi
    done
    # shellcheck source=/dev/null
    . "${BOX_CONFIG}" || {
        echo "claudebox-runner: ${BOX_CONFIG} failed to parse; fix it or move it aside" >&2
        exit 2
    }
    for _s in "${!_from_env[@]}"; do printf -v "${_s}" '%s' "${_from_env[${_s}]}"; done
    unset _s _from_env
fi

export BOX_USER="${BOX_USER:-$(id -un)}"
export BOX_UID="${BOX_UID:-$(id -u)}"
export BOX_GID="${BOX_GID:-$(id -g)}"
export BOX_RUNNER_PORT="${BOX_RUNNER_PORT:-7998}"
# Where the runner keeps its copy of the source. Inside a named volume, so this
# is a path in the container and not on this machine's disk -- it matters only
# because a nested "docker run -v" resolves its source against it.
export BOX_RUNNER_WORKSPACE="${BOX_RUNNER_WORKSPACE:-/home/${BOX_USER}/Projects}"
export BOX_RUNNER_BASE_IMAGE="${BASE_IMAGE}"

DIND_APPARMOR_TAG=claudebox-runner
DIND_APPARMOR_DIR="${BOX_DIR}"
DIND_APPARMOR_CONTAINER=claudebox-runner-dind
# shellcheck source=dind-apparmor.sh
. "${BOX_DIR}/dind-apparmor.sh"

# ---------------------------------------------------------------------------
# The join line
#
# What the agent machine needs in order to reach this one: an address, the
# token, and the certificate fingerprint to pin. All three are generated by
# runner/entrypoint.sh on first start and live in the runner-state volume, so
# this reads them back rather than keeping a copy.
# ---------------------------------------------------------------------------
runner_state() {
    docker exec "${STATE_CONTAINER}" cat "/var/lib/claudebox-runner/${1}" 2>/dev/null | tr -d '\r\n'
}

lan_address() {
    # The address this machine is reachable at from the rest of the LAN: the
    # source address of the route out. Printed rather than guessed at silently,
    # because a machine with several interfaces may want a different one and the
    # join line is a thing a person reads before running.
    ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src") {print $(i+1); exit}}'
}

print_join() {
    local token fp addr
    token="$(runner_state token)"
    fp="$(runner_state fingerprint)"
    if [ -z "${token}" ] || [ -z "${fp}" ]; then
        echo "claudebox-runner: the runner is not running, so its identity cannot be read." >&2
        echo "claudebox-runner: start it first ('claudebox-runner')." >&2
        return 1
    fi
    addr="$(lan_address)"
    [ -n "${addr}" ] || addr="<this machine's address>"
    cat <<EOF

claudebox-runner: ready. On the machine that runs the agent, run:

  claudebox runner add ${addr}:${BOX_RUNNER_PORT} ${token} ${fp}

That stores the address, the token and the certificate fingerprint in that
machine's ~/.claudebox/config. Nothing is stored here about it: this runner
accepts anything that presents the token over the pinned certificate.

EOF
}

case "${1:-}" in
    -h|--help|help)
        sed -n '3,22p' "$(readlink -f -- "${BASH_SOURCE[0]}")" | sed 's/^# \{0,1\}//'
        exit 0
        ;;

    join)
        print_join
        exit $?
        ;;

    status)
        "${COMPOSE[@]}" ps
        echo
        if [ -n "$(runner_state token)" ]; then
            echo "workspace volume: $(docker exec "${STATE_CONTAINER}" du -sh "${BOX_RUNNER_WORKSPACE}" 2>/dev/null | cut -f1) in ${BOX_RUNNER_WORKSPACE}"
            echo "projects synced:"
            docker exec "${STATE_CONTAINER}" ls -1 "${BOX_RUNNER_WORKSPACE}" 2>/dev/null | sed 's/^/  /'
            echo
            # DDEV projects live inside the sidecar's daemon, so this is the
            # only place they show up -- `ddev list` on this machine, if there
            # is a ddev on this machine at all, knows nothing about them.
            echo "DDEV projects (inside the sidecar):"
            docker exec -u "${BOX_USER}" -e HOME="/home/${BOX_USER}" "${STATE_CONTAINER}" \
                ddev list 2>/dev/null | sed 's/^/  /' || echo "  (none)"
        fi
        exit 0
        ;;

    logs)
        shift
        exec "${COMPOSE[@]}" logs "$@" runner
        ;;

    stop)
        exec "${COMPOSE[@]}" down
        ;;

    reset)
        # The synced tree is a copy; deleting it costs a full re-sync and
        # nothing else. The identity volume is left alone on purpose -- wiping
        # the tree should not force a re-join.
        echo "claudebox-runner: this deletes the synced workspace and every build" >&2
        echo "claudebox-runner: artifact in it. The runner's identity is kept." >&2
        printf 'claudebox-runner: continue? [y/N] ' >&2
        read -r reply
        case "${reply}" in
            y|Y|yes|YES) ;;
            *) echo "claudebox-runner: nothing done" >&2; exit 1 ;;
        esac
        "${COMPOSE[@]}" down
        docker volume rm claudebox-runner-workspace >/dev/null
        echo "claudebox-runner: workspace deleted; start again to re-create it" >&2
        exit 0
        ;;

    rebuild)
        dind_apparmor_preflight
        docker build --target base -t "${BASE_IMAGE}" \
            --build-arg "USERNAME=${BOX_USER}" \
            --build-arg "UID=${BOX_UID}" \
            --build-arg "GID=${BOX_GID}" \
            --no-cache "${BOX_DIR}"
        "${COMPOSE[@]}" build --no-cache
        "${COMPOSE[@]}" up -d --force-recreate
        print_join
        exit 0
        ;;

    "") ;;

    *)
        echo "claudebox-runner: unknown command '${1}' -- try --help" >&2
        exit 2
        ;;
esac

# ---------------------------------------------------------------------------
# Bring the runner up
# ---------------------------------------------------------------------------

dind_apparmor_preflight

# The base stage of the box's own Dockerfile, tagged so runner/Dockerfile can
# start from it. This is the parity guarantee made concrete: it is the same
# file, the same stage and the same build args as the image the agent runs in.
docker build --target base -t "${BASE_IMAGE}" \
    --build-arg "USERNAME=${BOX_USER}" \
    --build-arg "UID=${BOX_UID}" \
    --build-arg "GID=${BOX_GID}" \
    "${BOX_DIR}"

if ! "${COMPOSE[@]}" up -d --build; then
    dind_apparmor_postmortem || true
    exit 1
fi

# "up -d" returns once the container is started, not once its entrypoint has
# generated the token and the certificate -- and those are exactly what the join
# line is made of, so printing it immediately prints nothing.
for _ in $(seq 1 60); do
    [ "$(docker inspect -f '{{ .State.Health.Status }}' "${STATE_CONTAINER}" 2>/dev/null)" = "healthy" ] && break
    sleep 1
done

if [ "$(docker inspect -f '{{ .State.Health.Status }}' "${STATE_CONTAINER}" 2>/dev/null)" != "healthy" ]; then
    echo "claudebox-runner: the runner started but never became healthy. Its log:" >&2
    "${COMPOSE[@]}" logs --tail 40 runner >&2
    exit 1
fi

print_join
