# Material staged for the box's /media by "claudebox media add" -- copies of
# things that live on a drive somewhere, sometimes large. Never source.
/media/

# Per-machine settings: which drive holds the workspace, which ids the box runs
# as. config.example is the documented template and IS tracked.
/config

# Per-plugin scratch space, one directory per plugin, created on demand by
# plugin_state. Generated, so it is kept out of plugins/ itself -- that holds
# the plugins distributed with claudebox and is tracked.
/plugin-state/

# The client half of "claudebox mutagen attach": this machine's ssh key, the
# host keys it has pinned, the generated ssh config mutagen reads, and the stamp
# recording what the live session was created against. Generated per machine,
# and one of them is a private key.
/sync-client/

# The local copy of another machine's workspace, kept in step by mutagen.
#
# Real files -- unlike the sshfs mountpoint this replaces, it is never empty and
# never safe to assume is current. Nothing here is a place to put work by hand:
# it is one end of a two-way reconciler, so anything written here propagates to
# the other machine, and anything deleted here is deleted there.
/synced-workspace/

# Left over from the sshfs version this replaced: the old mountpoint, and the
# old client key directory. They are still on machines that have not migrated
# yet -- ~/.claudebox/remote-workspace may even still carry a live sshfs mount.
# Kept ignored so a half-migrated checkout does not show a few thousand
# untracked files; delete both once "claudebox mutagen attach" is in use.
/remote-workspace/
/ssh-client/

# The temporary-egress reaper's own scratch: its lock, its pid and its log.
# One short-lived host process per machine, started by "claudebox allow --for";
# nothing here is state, only a record of what it has withdrawn.
/.allow-reaper.lock
/.allow-reaper.pid
/.allow-reaper.log
# ("claudebox allow --for" also stages each rewrite in an allowlist.conf.XXXXXX
# beside the file, because the real one must be written over in place -- see the
# stale bind mount trap. They are removed immediately; this is for the crash.)
/allowlist.conf.*
